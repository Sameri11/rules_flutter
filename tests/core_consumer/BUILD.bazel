load("@rules_cc//cc:defs.bzl", "cc_binary")

package(default_visibility = ["//visibility:public"])

# A real action forces Bazel to resolve the host C++ toolchain. No Android
# platform, SDK, NDK, or Android-specific rule is needed by this consumer.
cc_binary(
    name = "core_action",
    srcs = ["core_action.cc"],
)
