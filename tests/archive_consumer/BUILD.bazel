# The standalone Android consumer: its only APK is the root's //:app.

load("@rules_flutter_android//flutter:defs.bzl", "FLUTTER_ANDROID", "flutter_android_app")
load("@rules_flutter_core//flutter:defs.bzl", "flutter_core")

package(default_visibility = ["//visibility:public"])

flutter_core(
    name = "core",
    native_build_env = "@rules_flutter_android//flutter:native_build_env",
    platforms = [FLUTTER_ANDROID],
    pub = "@pub",
)

# The manifest, resources and debug manifest follow the created layout under
# src/main and src/debug, so only the non-layout facts are stated here.
flutter_android_app(
    name = "app",
    core = ":core",
    manifest_values = {"applicationId": "com.example.archive_consumer"},
    # No plugins: the stock empty registrant is compiled instead of naming a
    # @flutter_plugins repository this root does not declare.
    plugins = None,
    deps = [":main_activity"],
)

kt_android_library(
    name = "main_activity",
    srcs = ["src/main/kotlin/com/example/archive_consumer/MainActivity.kt"],
    deps = [":app_inputs"],
)
