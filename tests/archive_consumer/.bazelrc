common --enable_bzlmod

# This module is consumed as an external root, so it imports nothing from a
# parent checkout: the ruleset modules arrive inside the archive.
build --merge_android_manifest_permissions

# rules_android requires JDK 17.
build --tool_java_language_version=17 --tool_java_runtime_version=remotejdk_17
build --java_language_version=17 --java_runtime_version=remotejdk_17

# The NDK is a repository input, so it is forwarded explicitly rather than
# read from the action environment.
common --repo_env=ANDROID_NDK_HOME

# One release arm64-v8a APK. The Target OS comes from this configured platform,
# not from a BUILD argument.
build --android_platforms=@rules_android//:arm64-v8a
build -c opt
build --@rules_flutter_core//flutter:mode=release

# The committed MODULE.bazel.lock pins every repository input. Build with
# --lockfile_mode=error so an unresolved archive or dependency fails instead
# of silently rewriting the lock; after an intentional dependency change,
# regenerate once with --lockfile_mode=update and commit the result.
