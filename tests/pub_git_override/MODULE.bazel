module(name = "pub_git_override_test")

bazel_dep(name = "sameri11_rules_flutter_core", version = "0.1.0", repo_name = "rules_flutter_core")
local_path_override(
    module_name = "sameri11_rules_flutter_core",
    path = "../../rules_flutter_core",
)

pub = use_extension("@rules_flutter_core//flutter:extensions.bzl", "pub")
pub.lock(
    name = "pub",
    lock = "//:pubspec.lock",
)

git_override = use_repo_rule("@bazel_tools//tools/build_defs/repo:local.bzl", "local_repository")

git_override(
    name = "pub_git_override",
    path = "package_override",
)

override_repo(
    pub,
    **{"pub-openfoodfacts_flutter_lints": "pub_git_override"}
)

use_repo(pub, "pub", "pub-openfoodfacts_flutter_lints")
