module(
    name = "namespace_dynamic_test",
    version = "0.0.1",
)

bazel_dep(name = "sameri11_rules_flutter_core", version = "0.1.0", repo_name = "rules_flutter_core")
bazel_dep(name = "sameri11_rules_flutter_android", version = "0.1.0", repo_name = "rules_flutter_android")
bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_android", version = "0.7.3")
bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "rules_jvm_external", version = "7.1")

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")

# Try the Central mirror before Central for rules_android's own installs.
maven.install(
    name = "rules_android_maven",
    known_contributing_modules = ["rules_android"],
    repositories = [
        "https://maven.google.com",
        "https://maven-central.storage-download.googleapis.com/maven2",
        "https://repo1.maven.org/maven2",
    ],
    use_starlark_android_rules = True,
)
maven.install(
    name = "android_ide_common_30_1_3",
    known_contributing_modules = ["rules_android"],
    repositories = [
        "https://maven.google.com",
        "https://maven-central.storage-download.googleapis.com/maven2",
        "https://repo1.maven.org/maven2",
    ],
    use_starlark_android_rules = True,
)

android_ndk = use_extension("@rules_flutter_android//flutter:extensions.bzl", "android_ndk")
use_repo(android_ndk, "androidndk", "androidndk_cmake")

local_path_override(
    module_name = "sameri11_rules_flutter_core",
    path = "../../rules_flutter_core",
)

local_path_override(
    module_name = "sameri11_rules_flutter_android",
    path = "../../rules_flutter_android",
)

dynamic_namespace_metadata = use_repo_rule("//:fixture.bzl", "dynamic_namespace_metadata")

dynamic_namespace_metadata(
    name = "dynamic_namespace_metadata",
    marker = "//:fixtures/namespace_dynamic/pubspec.yaml",
)

plugins = use_extension("@rules_flutter_android//flutter:extensions.bzl", "flutter_plugins_ext")
plugins.project(
    abis = ["arm64-v8a"],
    maven_repo = "//:dynamic_maven",
    metadata = "@dynamic_namespace_metadata//:plugins_metadata.json",
    package_config = "@dynamic_namespace_metadata//:package_config.json",
)
use_repo(plugins, "flutter_plugins")
