# Host tests of a plugin-free app, with no Android registration.

load("@rules_flutter//flutter:defs.bzl", "flutter_app", "flutter_test_suite")

package(default_visibility = ["//visibility:public"])

flutter_app(
    abis = ["arm64-v8a"],
    assets = [],
    plugin_deps = None,
    pub = "@pub",
)

flutter_test_suite(
    name = "tests",
    app = "//:app",
)
