module(
    name = "external_app",
    version = "0.0.1",
)

bazel_dep(name = "sameri11_rules_flutter_core", version = "0.1.0", repo_name = "rules_flutter_core")
bazel_dep(name = "sameri11_rules_flutter_android", version = "0.1.0", repo_name = "rules_flutter_android")
bazel_dep(name = "rules_jvm_external", version = "7.1")

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
use_repo(maven, plugin_maven_alias = "plugin_maven")

# The hub of the app's lock. Hub names are unique across modules.
pub = use_extension("@rules_flutter_core//flutter:extensions.bzl", "pub")
pub.lock(
    name = "external_app_pub",
    lock = "//app:pubspec.lock",
)
use_repo(pub, "external_app_pub")

# Report and ignore unmatched dependency recipes.
plugins = use_extension("@rules_flutter_android//flutter:extensions.bzl", "flutter_plugins_ext")
plugins.package(
    name = "absent_package",
    bzl_file = "//:absent_package.bzl",
)
plugins.project(
    abis = ["arm64-v8a"],
    maven_repo = "@plugin_maven_alias//:pin",
    metadata = "@external_app_pub//:plugins_metadata.json",
    package_config = "@external_app_pub//:package_config.json",
)
use_repo(plugins, flutter_plugins_alias = "flutter_plugins")
