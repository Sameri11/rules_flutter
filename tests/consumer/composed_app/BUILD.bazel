"""A composed app: one flutter_core artifact packaged by flutter_android_app.

The app's inputs come from the macro's inputs target over the composed_plugins hub, and
from a native AAR. The app's JNI library is linked into the binary. Each reaches the
APK through the android_binary deps, so the apk check sees all of them.
"""

load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_android//rules:rules.bzl", "aar_import", "android_binary")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_import.bzl", "cc_import")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load(
    "@rules_flutter_android//flutter:defs.bzl",
    "flutter_android_app",
)

# Exercise the generated native strip path without adding a public macro.
# buildifier: disable=bzl-visibility
load("@rules_flutter_android//flutter/private:native_strip.bzl", "android_native_files")
load("@rules_flutter_core//flutter:defs.bzl", "flutter_core")
load("@rules_java//java:defs.bzl", "java_import", "java_library")
load("@rules_java//java:java_single_jar.bzl", "java_single_jar")
load("@rules_kotlin//kotlin:android.bzl", "kt_android_library")
load("//:embedding_deps.bzl", "EMBEDDING_DEPS")
load(":direct_native.bzl", "direct_native")
load(":native_files_test.bzl", "native_files_check")

package(default_visibility = ["//visibility:private"])

exports_files([
    "pubspec.lock",
    "recipe_package.bzl",
])

flutter_core(
    name = "core",
    srcs = glob(["lib/**/*.dart"]),
    assets = ["assets/composed-marker.txt"],
    native_build_env = "@rules_flutter_android//flutter:native_build_env",
    # Sources of the path plugin, declared so pub_path_deps_check accepts it.
    path_deps = [
        "//:cmake_plugin_srcs",
        "//:composed_plugin_srcs",
        "//:dev_cmake_plugin_srcs",
        "//:recipe_package_srcs",
    ],
    plugins = "@composed_plugins",
    pub = "@composed_pub",
)

# The AAR's classes, as a jar whose entries are timestamp-normalized.
java_library(
    name = "composed_aar_classes",
    srcs = ["aar/java/com/example/composed/aar/AarMarker.java"],
)

java_single_jar(
    name = "composed_aar_classes_jar",
    deps = [":composed_aar_classes"],
)

# A linkshared cc_binary, named for the library it produces.
cc_binary(
    name = "libaar_native.so",
    srcs = ["native/aar_native.cc"],
    linkshared = True,
    tags = ["manual"],
)

# Each raw output is built and stripped with its Android ABI's toolchain.
android_native_files(
    name = "aar_native_files",
    src = [":libaar_native.so"],
    abi = "arm64-v8a",
)

android_native_files(
    name = "aar_native_files_x86_64",
    src = [":libaar_native.so"],
    abi = "x86_64",
)

android_native_files(
    name = "aar_native_files_armeabi_v7a",
    src = [":libaar_native.so"],
    abi = "armeabi-v7a",
)

# These negative targets plant an input with no native payload for every
# supported fixture ABI. Each requested ABI must fail rather than yield an
# empty AAR library directory.
android_native_files(
    name = "aar_missing_native_arm64",
    src = [":composed_aar_classes_jar"],
    abi = "arm64-v8a",
    tags = ["manual"],
)

android_native_files(
    name = "aar_missing_native_x86_64",
    src = [":composed_aar_classes_jar"],
    abi = "x86_64",
    tags = ["manual"],
)

android_native_files(
    name = "aar_missing_native_armeabi_v7a",
    src = [":composed_aar_classes_jar"],
    abi = "armeabi-v7a",
    tags = ["manual"],
)

# The aar is a zip built with a fixed entry order and timestamps, so the same
# inputs always give the same bytes.
genrule(
    name = "composed_aar_zip",
    srcs = [
        "aar/AndroidManifest.xml",
        ":aar_native_files",
        ":aar_native_files_x86_64",
        ":aar_native_files_armeabi_v7a",
        ":composed_aar_classes_jar",
    ],
    outs = ["composed_aar.aar"],
    cmd = """set -euo pipefail
out="$$PWD/$@"
stage="$$(mktemp -d)"
trap 'rm -rf "$$stage"' EXIT
mkdir -p "$$stage/jni/arm64-v8a" "$$stage/jni/x86_64" "$$stage/jni/armeabi-v7a"
cp "$(location aar/AndroidManifest.xml)" "$$stage/AndroidManifest.xml"
cp "$(location :composed_aar_classes_jar)" "$$stage/classes.jar"
cp "$(location :aar_native_files)" "$$stage/jni/arm64-v8a/libaar_native.so"
cp "$(location :aar_native_files_x86_64)" "$$stage/jni/x86_64/libaar_native.so"
cp "$(location :aar_native_files_armeabi_v7a)" "$$stage/jni/armeabi-v7a/libaar_native.so"
chmod 644 "$$stage/AndroidManifest.xml" "$$stage/classes.jar" "$$stage"/jni/*/libaar_native.so
find "$$stage" -exec touch -t 198001010000 {} +
cd "$$stage"
zip -X -D -q "$$out" AndroidManifest.xml classes.jar jni/arm64-v8a/libaar_native.so jni/x86_64/libaar_native.so jni/armeabi-v7a/libaar_native.so
""",
)

aar_import(
    name = "composed_aar",
    aar = ":composed_aar.aar",
)

cc_library(
    name = "marker_dependency_objects",
    srcs = ["native/marker_dependency.cc"],
    alwayslink = True,
)

cc_binary(
    name = "libmarker_dependency.so",
    linkshared = True,
    deps = [":marker_dependency_objects"],
)

cc_import(
    name = "marker_dependency_shared",
    shared_library = ":libmarker_dependency.so",
)

cc_binary(
    name = "librecipe_marker.so",
    srcs = ["native/recipe_marker.cc"],
    linkshared = True,
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

cc_binary(
    name = "libcmake_marker.so",
    srcs = ["native/override_marker.cc"],
    linkshared = True,
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

# The app's own JNI library. android_binary links it into the APK's lib<apk>.so, which
# the apk check accepts as a native of the binary. alwayslink keeps the JNI entry points,
# which only the VM and the plugin reference.
cc_library(
    name = "composed_jni",
    srcs = ["native/composed_jni.cc"],
    tags = ["manual"],
    deps = [":marker_dependency_shared"],
    alwayslink = True,
)

# The binary. The macro declares apk_inputs over the core and the plugin hub, and the
# version comes from pubspec.yaml through that inputs target.
flutter_android_app(
    name = "apk",
    core = ":core",
    manifest = "AndroidManifest.xml",
    manifest_values = {
        "applicationId": "com.example.composed_app",
    },
    # The fixture has no src/main/res.
    plugins = "@composed_plugins",
    resource_files = [],
    deps = [
        ":composed_aar",
        ":composed_jni",
    ],
)

# A second binary over the same inputs: the engine, AOT library and assets are built once.
flutter_android_app(
    name = "apk_variant",
    inputs = ":apk_inputs",
    manifest = "AndroidManifest.xml",
    manifest_values = {
        "applicationId": "com.example.composed_app.variant",
    },
    resource_files = [],
    deps = [
        ":composed_aar",
        ":composed_jni",
    ],
)

native_files_check(
    name = "native_files_coexistence_check",
    carrier = "@composed_plugins//:flutter_native_files_by_abi",
    expected = [
        "libcmake_marker.so",
        "librecipe_marker.so",
    ] + select({
        "@rules_flutter_core//flutter:mode_debug": ["libdev_cmake_marker.so"],
        "@rules_flutter_core//flutter:mode_release": [],
    }),
    override = False,
)

native_files_check(
    name = "native_files_override_check",
    carrier = "@composed_override_plugins//:flutter_native_files_by_abi",
    expected = [
        "libcmake_marker.so",
        "librecipe_marker.so",
    ] + select({
        "@rules_flutter_core//flutter:mode_debug": ["libdev_cmake_marker.so"],
        "@rules_flutter_core//flutter:mode_release": [],
    }),
    override = True,
)

build_test(
    name = "native_files_test",
    targets = [
        ":native_files_coexistence_check",
        ":native_files_override_check",
    ],
)

flutter_android_app(
    name = "apk_override",
    core = ":core",
    manifest = "AndroidManifest.xml",
    manifest_values = {"applicationId": "com.example.composed_app.override"},
    plugins = "@composed_override_plugins",
    resource_files = [],
    deps = [
        ":composed_aar",
        ":composed_jni",
    ],
)

genrule(
    name = "apk_override_contents_check",
    srcs = [":apk_override.apk"],
    outs = ["apk_override_contents.checked"],
    cmd = """set -eu
listing="$$(unzip -Z1 $(location :apk_override.apk))"
for lib in libcmake_marker.so librecipe_marker.so libaar_native.so libmarker_dependency.so; do
  echo "$$listing" | grep -E "^lib/[^/]+/$$lib$$" > /dev/null
done
printf 'native libraries present\\n' > "$@"
""",
)

build_test(
    name = "apk_override_contents_test",
    tags = ["manual"],
    targets = [":apk_override_contents_check"],
)

filegroup(
    name = "direct_assets",
    srcs = [":core"],
    output_group = "flutter_assets",
    tags = ["manual"],
)

filegroup(
    name = "direct_engine",
    srcs = [":core"],
    output_group = "flutter_engine",
    tags = ["manual"],
)

filegroup(
    name = "direct_libapp",
    srcs = [":core"],
    output_group = "flutter_libapp",
    tags = ["manual"],
)

filegroup(
    name = "direct_embedding_jar",
    srcs = [":core"],
    output_group = "flutter_embedding",
    tags = ["manual"],
)

java_import(
    name = "direct_embedding",
    jars = [":direct_embedding_jar"],
    tags = ["manual"],
    exports = EMBEDDING_DEPS,
    deps = EMBEDDING_DEPS,
)

direct_native(
    name = "direct_native_files",
    engine = ":direct_engine",
    libapp = ":direct_libapp",
    tags = ["manual"],
)

cc_library(
    name = "direct_native",
    srcs = [":direct_native_files"] + select({
        "@platforms//cpu:arm64": ["@composed_plugins//:native_files_arm64-v8a"],
        "@platforms//cpu:x86_64": ["@composed_plugins//:native_files_x86_64"],
        "@platforms//cpu:armv7": ["@composed_plugins//:native_files_armeabi-v7a"],
        "//conditions:default": [],
    }),
    tags = ["manual"],
)

kt_android_library(
    name = "direct_activity",
    srcs = ["DirectActivity.kt"],
    tags = ["manual"],
    deps = [":direct_embedding"],
)

android_binary(
    name = "direct_apk",
    assets = [":direct_assets"],
    assets_dir = "core_bundle_action",
    manifest = "AndroidManifest.xml",
    manifest_values = {
        "applicationId": "com.example.composed_app.direct",
        "minSdkVersion": "24",
        "targetSdkVersion": "36",
    },
    nocompress_extensions = [".so"],
    resource_files = [],
    deps = [
        ":composed_aar",
        ":composed_jni",
        ":direct_activity",
        ":direct_embedding",
        ":direct_native",
        "@composed_plugins//:generated_plugin_registrant",
    ],
)
