genrule(
    name = "apk_external_app_contents_check",
    srcs = [":apk_external_app.apk"],
    outs = ["apk_external_app_contents.checked"],
    cmd = """set -euo pipefail
value="$$(unzip -p $(location :apk_external_app.apk) assets/flutter_assets/assets/external-marker.txt)"
test "$$value" = "external app marker"
printf 'checked external app asset\\n' > "$@"
""",
)

build_test(
