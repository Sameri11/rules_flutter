"""Every public symbol, instantiated the way a consumer would.

This is an API test, not a behaviour test.
"""

load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_flutter//tools/flutter:abis.bzl", "ABIS", "aot_gen_snapshot", "aot_target_compatible_with", "plugin_repo_target")
load("@rules_flutter//tools/flutter:android.bzl", "android_native_lib_jar", "flutter_android_binary", "flutter_android_libs", "flutter_assets_dir", "jni_lib_jar", "strip_native_libs")
load("@rules_flutter//tools/flutter:bundle.bzl", "CLASSES", "NATIVE_LIB", "flutter_bundle_contribution")
load("@rules_flutter//tools/flutter:defs.bzl", "dart_aot_elf", "dart_kernel", "flutter_aot_library", "flutter_assets", "pub_path_deps_check", "pub_plugins_check")
load("@rules_flutter//tools/flutter:embedding.bzl", "flutter_embedding_library")
load("@rules_flutter//tools/flutter:pubspec.bzl", "flutter_pubspec")
load("@rules_flutter//tools/flutter:recipe.bzl", "flutter_native_contribution", "flutter_native_libs")
load("@rules_java//java:defs.bzl", "java_import")
load(":assertions.bzl", "expect_equal", "expect_label_equal")

package(default_visibility = ["//visibility:private"])

# `//standard_layout` exercises `flutter_app` defaults. This fixture names every
# attribute explicitly to catch removed defaults.

# --- defs.bzl: the platform-independent half ---------------------------------

# The single entry point for every pubspec fact.
flutter_pubspec(
    name = "pubspec",
    src = "fixtures/pubspec.yaml",
)

dart_kernel(
    name = "kernel",
    srcs = ["lib/main.dart"],
    entrypoint = "lib/main.dart",
    package_config = "fixtures/package_config.json",
    pubspec = ":pubspec",
)

# target_os is the 0.3 attribute. Named explicitly rather than left default, so
# renaming or removing it fails here.
dart_kernel(
    name = "kernel_ios",
    srcs = ["lib/main.dart"],
    entrypoint = "lib/main.dart",
    package_config = "fixtures/package_config.json",
    pubspec = ":pubspec",
    target_os = "ios",
)

dart_aot_elf(
    name = "aot",
    dill = ":kernel",
    gen_snapshot = aot_gen_snapshot("arm64-v8a"),
    snapshot_flags = ABIS["arm64-v8a"].snapshot_flags,
    strip = True,
    target_compatible_with = aot_target_compatible_with(),
)

# The ABI carrying gen_snapshot flags. Named so a table entry losing them is an
# analysis-visible change here rather than a silent one in a snapshot.
dart_aot_elf(
    name = "aot_armv7",
    dill = ":kernel",
    gen_snapshot = aot_gen_snapshot("armeabi-v7a"),
    snapshot_flags = ABIS["armeabi-v7a"].snapshot_flags,
    strip = True,
    target_compatible_with = aot_target_compatible_with(),
)

expect_equal(
    ABIS["armeabi-v7a"].snapshot_flags,
    [
        "--no-sim-use-hardfp",
        "--no-use-integer-division",
    ],
    "armeabi-v7a snapshot_flags",
)

# Keep each ABI's explicit CPU constraint aligned with the table.
expect_label_equal(
    ABIS["arm64-v8a"].cpu_constraint,
    "@platforms//cpu:arm64",
    "arm64-v8a cpu_constraint",
)

expect_label_equal(
    ABIS["x86_64"].cpu_constraint,
    "@platforms//cpu:x86_64",
    "x86_64 cpu_constraint",
)

expect_label_equal(
    ABIS["armeabi-v7a"].cpu_constraint,
    "@platforms//cpu:armv7",
    "armeabi-v7a cpu_constraint",
)

# The macro, with every named parameter supplied -- it is the public entry point
# most consumers use, and its signature is the thing most likely to drift.
flutter_aot_library(
    name = "aot_library",
    srcs = ["lib/main.dart"],
    # Required and always a list; produces one target per entry.
    abis = [
        "arm64-v8a",
        "x86_64",
        "armeabi-v7a",
    ],
    dart_plugin_registrant = "lib/registrant.dart",
    entrypoint = "lib/main.dart",
    package_config = "fixtures/package_config.json",
    path_deps = [],
    pub_stamp = ["fixtures/pubspec.lock"],
    pubspec = ":pubspec",
    strip = True,
    target_os = "android",
)

flutter_assets(
    name = "assets",
    srcs = ["lib/main.dart"],
    abis = ["arm64-v8a"],
    assets = [],
    entrypoint = "lib/main.dart",
    package_config = "fixtures/package_config.json",
    pub_stamp = ["fixtures/pubspec.lock"],
    pubspec = ":pubspec",
)

pub_path_deps_check(
    name = "path_deps_check",
    path_deps = [],
    pubspec_lock = "fixtures/pubspec.lock",
)

pub_plugins_check(
    name = "plugins_check",
    committed = "fixtures/pubspec.yaml",
    expected = "fixtures/pubspec.yaml",
)

# --- android.bzl: the Android half -------------------------------------------

jni_lib_jar(
    name = "jni_jar",
    src = "fixtures/libfake.so",
    # Mandatory: it decides which lib/<abi>/ a library loads from.
    abi = "arm64-v8a",
)

strip_native_libs(
    name = "stripped",
    # Mandatory: it selects the cross-strip that matches the jar's libraries,
    # and the build platform is derived from it rather than restated.
    abi = "arm64-v8a",
    jar = "fixtures/fake_native_libs.jar",
)

# `src` takes rule targets, not source files -- in real use it is a
# rules_foreign_cc cmake(). A filegroup is the cheapest stand-in that satisfies
# that shape.
filegroup(
    name = "fake_cmake_output",
    srcs = ["fixtures/libfake.so"],
)

android_native_lib_jar(
    name = "native_lib_jar",
    src = [":fake_cmake_output"],
    # Mandatory, and the platform the .so is built under comes from it: two
    # strings kept in step by hand is how a jar comes to say one ABI while the
    # cross-compile resolves another's toolchain.
    abi = "arm64-v8a",
)

# --- recipe.bzl: the contract consumers implement ----------------------------
#
# The highest-value target here. This is the contract every package recipe
# writes against, it is what a v2/v3 migration changes, and it is the cheapest
# rule in the set to instantiate honestly.

flutter_native_contribution(
    name = "recipe_contribution",
    code_assets = {"package:fake/fake.dart": "libfake.so"},
    libraries = {"arm64-v8a": "fixtures/libfake.so"},
)

# The iOS side, here to hold the shape: the slice key is an .xcframework
# LibraryIdentifier, the code asset resolves to a path inside a bundle rather
# than a bare soname, and neither is subject to Android's .so gate.
flutter_native_contribution(
    name = "recipe_contribution_ios",
    code_assets = {"package:fake/fake.dart": "fake.framework/fake"},
    libraries = {"ios-arm64_x86_64-simulator": "fixtures/fake.framework/fake"},
    platform = "ios",
)

# The other side of the contract: a recipe that deliberately contributes
# nothing. VI.2 names this as the first real user of `empty` on Apple, so it
# should keep working.
flutter_native_contribution(
    name = "recipe_contribution_empty",
    empty = True,
)

flutter_native_libs(
    name = "recipe_libs",
    # Mandatory: it selects which slice of each contribution is taken *and*, on
    # Android, the lib/<abi>/ the libraries are packaged under. It used to be
    # two attributes carrying the same string.
    slice = "arm64-v8a",
    deps = [
        ":recipe_contribution",
        ":recipe_contribution_empty",
    ],
)

# No `flutter_native_libs(platform = "ios")` here: the rule now refuses it. Its
# body stages lib/<slice>/ into a jar, which is Android's shape, so an Apple
# aggregate needs a new action rather than this rule with a different attribute.
# The *contribution* above is what holds the Apple shape until then.

# --- the packaging join ------------------------------------------------------
#
# The entry point a consumer's android_binary depends on. Its arguments are all
# supplied by the consuming project -- the embedding and its Maven deps cannot
# be resolved inside the rules -- so a signature change is a consumer break.

# Production embedding path for the no-plugin APK below. It derives the
# AndroidX labels from this consumer's @flutter_maven repository.
flutter_embedding_library(name = "flutter_embedding_no_plugins")

java_import(
    name = "fake_embedding",
    jars = ["fixtures/fake_native_libs.jar"],
)

java_import(
    name = "fake_plugins",
    jars = ["fixtures/fake_native_libs.jar"],
)

java_import(
    name = "fake_recipe_libs",
    jars = ["fixtures/fake_native_libs.jar"],
)

# A distinct jar, not the same one twice: a jar carries its ABI in the
# lib/<abi>/ prefix inside it, so reusing one is what the join refuses.
java_import(
    name = "fake_recipe_libs_x86_64",
    jars = ["fixtures/fake_native_libs_x86_64.jar"],
)

# The plugins' native half, on its own per-ABI path rather than riding the
# plugin library. java_import, not a file: native libraries are found on
# android_binary's classpath.
java_import(
    name = "fake_plugin_libs",
    jars = ["fixtures/fake_native_libs.jar"],
)

java_import(
    name = "fake_plugin_libs_x86_64",
    jars = ["fixtures/fake_native_libs_x86_64.jar"],
)

java_import(
    name = "fake_registrant",
    jars = ["fixtures/fake_native_libs.jar"],
)

# Asserted rather than merely called: a silently wrong prefix is the failure it
# exists to prevent, and this module's assets target sits in the root package,
# the case with no separator.
expect_equal(
    flutter_assets_dir(assets = ":assets"),
    "assets",
    "flutter_assets_dir(':assets')",
)

# Two ABIs, so the per-ABI shape is exercised rather than degenerating to one
# entry, and `aot` is the real flutter_aot_library above -- the join derives
# `<aot>_<abi>` from it, and a rename breaks that.
#
# `engine_jars` only because this test must not fetch: the ABI table would name
# the real engine repositories, and analysing one downloads ~150 MB.
flutter_android_libs(
    name = "bundle",
    abis = [
        "arm64-v8a",
        "x86_64",
    ],
    aot = "aot_library",
    assets = ":assets",
    embedding = ":fake_embedding",
    embedding_deps = [],
    engine_jars = {
        "arm64-v8a": "fixtures/fake_native_libs.jar",
        "x86_64": "fixtures/fake_native_libs_x86_64.jar",
    },
    native_libs = {
        "arm64-v8a": ":fake_recipe_libs",
        "x86_64": ":fake_recipe_libs_x86_64",
    },
    # Populated rather than `{}`: the empty form is what a consumer reaches by
    # accident, so the populated one is what needs pinning.
    plugin_native_libs = {
        "arm64-v8a": ":fake_plugin_libs",
        "x86_64": ":fake_plugin_libs_x86_64",
    },
    plugins = ":fake_plugins",
    registrant = ":fake_registrant",
)

# The contribution rule on its own, in all three forms: slice-keyed, not, and
# the `empty = True` one VI.2 names as the first thing a non-Android platform
# needs.
flutter_bundle_contribution(
    name = "contribution",
    srcs = ["fixtures/libfake.so"],
    kind = "aot_library",
    location = NATIVE_LIB,
)

flutter_bundle_contribution(
    name = "contribution_sliced",
    kind = "recipe_libraries",
    libraries = {
        "arm64-v8a": "fixtures/libfake.so",
        "x86_64": "fixtures/libfake.so",
    },
    location = NATIVE_LIB,
)

flutter_bundle_contribution(
    name = "contribution_empty",
    srcs = [],
    empty = True,
    kind = "runtime_classes",
    location = CLASSES,
)

# The macro on top of the join: it emits `<name>` plus `<name>_<abi>`, so a
# consumer's APK targets are named by it and a rename here is a rename in their
# CI scripts. Two ABIs, because the per-ABI variants only exist above one.
#
# Everything is named explicitly here, defaults included, because a default that
# disappears is exactly the kind of change this module exists to notice. The
# derived spelling is covered by :apk_derived below.
flutter_android_binary(
    name = "apk",
    abis = [
        "arm64-v8a",
        "x86_64",
    ],
    aot = "aot_library",
    assets = ":assets",
    embedding = ":fake_embedding",
    embedding_deps = [],
    engine_jars = {
        "arm64-v8a": "fixtures/fake_native_libs.jar",
        "x86_64": "fixtures/fake_native_libs_x86_64.jar",
    },
    manifest = "fixtures/AndroidManifest.xml",
    manifest_values = {"applicationId": "com.example.consumer_test"},
    native_libs = {
        "arm64-v8a": ":fake_recipe_libs",
        "x86_64": ":fake_recipe_libs_x86_64",
    },
    plugin_native_libs = {
        "arm64-v8a": ":fake_plugin_libs",
        "x86_64": ":fake_plugin_libs_x86_64",
    },
    plugins = ":fake_plugins",
    # Required: an APK with no versionCode cannot be published, so "unset" is
    # not a state the macro lets a consumer reach by omission.
    pubspec = ":pubspec",
    registrant = ":fake_registrant",
    resource_files = [],
    tags = ["manual"],
    deps = [":fake_registrant"],
)

# The Dart half under its conventional name, so the `app` spelling below has the
# three targets it derives to. flutter_app() produces exactly these names.
flutter_aot_library(
    name = "app",
    srcs = ["lib/main.dart"],
    abis = [
        "arm64-v8a",
        "x86_64",
    ],
    entrypoint = "lib/main.dart",
    package_config = "fixtures/package_config.json",
    pub_stamp = ["fixtures/pubspec.lock"],
    pubspec = ":pubspec",
)

# The short spelling a standard-layout consumer writes: one label for the Dart
# half instead of three, and the manifest, resources and version derived from
# it. This target supplies fake plugin targets to exercise the explicit
# override path; :apk_no_plugin_graph below exercises the repository-free path.
flutter_android_binary(
    name = "apk_derived",
    abis = [
        "arm64-v8a",
        "x86_64",
    ],
    app = "//:app",
    embedding = ":fake_embedding",
    embedding_deps = [],
    engine_jars = {
        "arm64-v8a": "fixtures/fake_native_libs.jar",
        "x86_64": "fixtures/fake_native_libs_x86_64.jar",
    },
    manifest = "fixtures/AndroidManifest.xml",
    manifest_values = {"applicationId": "com.example.consumer_test"},
    native_libs = {
        "arm64-v8a": ":fake_recipe_libs",
        "x86_64": ":fake_recipe_libs_x86_64",
    },
    plugin_native_libs = {
        "arm64-v8a": ":fake_plugin_libs",
        "x86_64": ":fake_plugin_libs_x86_64",
    },
    plugins = ":fake_plugins",
    registrant = ":fake_registrant",
    resource_files = [],
    tags = ["manual"],
    deps = [":fake_registrant"],
)

# `plugin_native_libs = {}` -- the declaration an app with no native plugin half
# makes. It cannot be derived: the generated jars exist for every ABI whether or
# not anything filled them, so emptiness has to be said, and saying it is what
# satisfies the contribution's non-empty gate. Analysed here so the meaning of
# `{}` cannot quietly change into "derive".
flutter_android_binary(
    name = "apk_no_plugin_natives",
    abis = ["arm64-v8a"],
    app = "//:app",
    embedding = ":fake_embedding",
    embedding_deps = [],
    engine_jars = {"arm64-v8a": "fixtures/fake_native_libs.jar"},
    manifest = "fixtures/AndroidManifest.xml",
    manifest_values = {"applicationId": "com.example.consumer_test"},
    native_libs = {"arm64-v8a": ":fake_recipe_libs"},
    plugin_native_libs = {},
    plugins = ":fake_plugins",
    registrant = ":fake_registrant",
    resource_files = [],
    tags = ["manual"],
    deps = [":fake_registrant"],
)

# The three stub APKs above are `manual`: their `<name>_check_test` would make
# `bazel test` build fixtures that cannot build -- a fake engine jar with no ELF
# inside it, and a stub package_config with no resolvable package. They are
# analysis fixtures, and this filegroup is what keeps them in `//...` for
# `--nobuild` while `--build_tests_only` leaves them alone. Every variant is
# named: `manual` hides `:apk_x86_64` and friends too, and the per-ABI variants
# are half of what the join is instantiated over two ABIs to exercise.
filegroup(
    name = "analysis_only",
    srcs = [
        ":apk",
        ":apk_arm64-v8a",
        ":apk_derived",
        ":apk_derived_arm64-v8a",
        ":apk_derived_x86_64",
        ":apk_no_plugin_natives",
        ":apk_x86_64",
    ],
)

# The complete no-plugin-graph shape. The Dart package sets
# `plugin_deps = None`; the Android half sets `plugins = None`. That one value
# suppresses every derived @flutter_plugins label: Java/Kotlin plugin classes,
# recipe libraries, native plugin libraries and the registrant are each emitted
# as a deliberately empty contribution, while AOT, engine, embedding and assets
# remain structural. The embedding still needs @flutter_maven's AndroidX graph.
flutter_android_binary(
    name = "apk_no_plugin_graph",
    abis = [
        "arm64-v8a",
        "x86_64",
    ],
    app = "//standard_layout",
    embedding = ":flutter_embedding_no_plugins",
    manifest = "fixtures/AndroidManifest.xml",
    manifest_values = {"applicationId": "com.example.consumer_test"},
    plugins = None,
    resource_files = [],
)

# An external standard-layout app through the high-level API: app-derived
# labels must preserve its repository through Dart compilation and APK assets.
flutter_android_binary(
    name = "apk_external_app",
    abis = ["arm64-v8a"],
    app = "@external_app//app",
    embedding = ":flutter_embedding_no_plugins",
    manifest = "fixtures/AndroidManifest.xml",
    manifest_values = {"applicationId": "com.example.external_app"},
    plugins = None,
    resource_files = [],
)

genrule(
    name = "apk_external_app_contents_check",
    srcs = [":apk_external_app.apk"],
    outs = ["apk_external_app_contents.checked"],
    cmd = """set -euo pipefail
value="$$(unzip -p $(location :apk_external_app.apk) assets/flutter_assets/assets/external-marker.txt)"
test "$$value" = "external app marker"
printf 'checked external app asset\n' > "$@"
""",
)

build_test(
    name = "apk_external_app_contents_test",
    targets = [":apk_external_app_contents_check"],
)

# External-plugin regression: dependency recipes are ignored, and generated
# Maven labels use this project's mapping.
pub_plugins_check(
    name = "fake_plugin_deps_check",
    committed = "fixtures/plugin_deps.MODULE.bazel",
    expected = "@flutter_plugins//:plugin_deps.MODULE.bazel",
)

build_test(
    name = "fake_plugin_test",
    targets = [
        # Unlike every other fixture, this module names the repository
        # `plugin_maven`. Building the plugin verifies that `maven_repo` reaches
        # `maven_label()` through the caller's repository mapping.
        "@flutter_plugins//fake_plugin:fake_plugin",
        # A Kotlin-only plugin leaves this per-ABI native aggregate empty. It
        # must still provide JavaInfo through an empty `java_library`.
        "@flutter_plugins//:" + plugin_repo_target("plugin_native_libraries", "arm64-v8a"),
    ],
)

# Decoy package verifies macro select keys resolve in this repository.
alias(
    name = "embedding_mode_hazard_expected",
    actual = select({
        "@rules_flutter//tools/flutter:mode_debug": "@flutter_embedding_debug//jar:file",
        "@rules_flutter//tools/flutter:mode_release": "@flutter_embedding_release//jar:file",
    }),
)

genrule(
    name = "embedding_mode_hazard_check",
    srcs = [
        ":flutter_embedding_no_plugins",
        ":embedding_mode_hazard_expected",
    ],
    outs = ["embedding_mode_hazard.checked"],
    cmd = """set -euo pipefail
if ! cmp -s "$(location :flutter_embedding_no_plugins)" "$(location :embedding_mode_hazard_expected)"; then
    echo "flutter_embedding_no_plugins is not this configuration's embedding" >&2
    echo "jar. embedding.bzl's jars select() resolved a select() key against" >&2
    echo "the decoy //tools/flutter package instead of @rules_flutter's --" >&2
    echo "see the comment above." >&2
    exit 1
fi
printf 'embedding.bzl select() resolved against @rules_flutter, not the decoy\n' > "$@"
""",
)

build_test(
    name = "embedding_mode_hazard_test",
    targets = [":embedding_mode_hazard_check"],
)
