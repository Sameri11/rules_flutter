    name = "build_config_plugin_values",
    srcs = ["fixtures/BuildConfigValues.java"],
    main_class = "com.example.consumer.BuildConfigValues",
    runtime_deps = [":build_config_runtime_embedding"],
    deps = [
        "@flutter_plugins//build_config_plugin",
    ],
)

genrule(
    name = "build_config_plugin_values_check",
    outs = ["build_config_plugin_values.checked"],
    cmd = select({
        "@rules_flutter_core//flutter:mode_debug": """set -eu
actual="$$( $(location :build_config_plugin_values) )"
test "$$actual" = "true:debug:com.example.build_config_plugin:explicit-value:1.2.3:true:127:-32768:2147483640:9223372036854775807:3.4028235E38:4.9E-324"
printf '%s\\n' "$$actual" > "$@"
""",
        "@rules_flutter_core//flutter:mode_release": """set -eu
actual="$$( $(location :build_config_plugin_values) )"
test "$$actual" = "false:release:com.example.build_config_plugin:explicit-value:1.2.3:true:127:-32768:2147483640:9223372036854775807:3.4028235E38:4.9E-324"
printf '%s\\n' "$$actual" > "$@"
""",
    }),
    tools = [":build_config_plugin_values"],
)

build_test(
    name = "build_config_plugin_values_test",
    targets = [":build_config_plugin_values_check"],
)

