"""The supported BUILD API for a Consumer Module.

Core rules load from @rules_flutter_core//flutter:defs.bzl. Hand-wired core
targets may also load composition.bzl; Android macros load from
@rules_flutter_android//flutter:defs.bzl, with hand-wired rules in composition.bzl.
"""

load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_flutter_android//flutter:composition.bzl", "flutter_android_inputs", "flutter_embedding_deps")
load("@rules_flutter_android//flutter:defs.bzl", "FLUTTER_ANDROID", "flutter_android_app", "flutter_assets", "flutter_native_contribution", "flutter_plugin_deps_guards")
load("@rules_flutter_core//flutter:composition.bzl", "pub_path_deps_check")
load("@rules_flutter_core//flutter:defs.bzl", "flutter_core", "flutter_package", "flutter_pubspec", "flutter_test")
load("@rules_java//java:defs.bzl", "java_binary", "java_import")
load(
    "@rules_kotlin//kotlin:android.bzl",
    "kt_android_library",
)

package(default_visibility = ["//visibility:private"])

flutter_plugin_deps_guards(
    name = "fake_plugin_deps",
    committed = "fixtures/plugin_deps.MODULE.bazel",
    plugins = "@flutter_plugins",
)

exports_files(["build_config_probe.py"])

# The sources of the path plugin composed_app depends on. pub_path_deps_check
# requires every `path:` dependency's files to be declared, and a package cannot
# glob another package's directory.
filegroup(
    name = "composed_plugin_srcs",
    srcs = glob(["fixtures/composed_plugin/**"]),
    visibility = ["//composed_app:__pkg__"],
)

filegroup(
    name = "cmake_plugin_srcs",
    srcs = glob(["fixtures/cmake_plugin/**"]),
    visibility = ["//composed_app:__pkg__"],
)

filegroup(
    name = "recipe_package_srcs",
    srcs = glob(["fixtures/recipe_package/**"]),
    visibility = ["//composed_app:__pkg__"],
)

filegroup(
    name = "dev_cmake_plugin_srcs",
    srcs = glob(["fixtures/dev_cmake_plugin/**"]),
    visibility = ["//composed_app:__pkg__"],
)

filegroup(
    name = "production_probe_srcs",
    srcs = glob(["fixtures/production_probe/**"]),
    visibility = ["//composed_app:__pkg__"],
)

filegroup(
    name = "shared_probe_srcs",
    srcs = glob(["fixtures/shared_probe/**"]),
    visibility = ["//composed_app:__pkg__"],
)

filegroup(
    name = "dev_only_probe_srcs",
    srcs = glob(["fixtures/dev_only_probe/**"]),
)

# `//standard_layout` exercises `flutter_core` defaults for standard-layout
# sources/assets while naming the remaining attributes explicitly.

# --- defs.bzl: the platform-independent half ---------------------------------

# The single entry point for every pubspec fact.
flutter_pubspec(
    name = "fixture_pubspec",
    src = "pubspec.yaml",
)

flutter_package(
    name = "package",
    path_deps = [
        ":dev_only_probe_srcs",
        ":production_probe_srcs",
        ":shared_probe_srcs",
    ],
    pub = "@pub",
    pubspec = ":fixture_pubspec",
)

flutter_test(
    name = "package_test",
    src = "test/package_test.dart",
    app = ":package",
)

# The macro, with every named parameter supplied -- it is the public entry point
# most consumers use, and its signature is the thing most likely to drift.
flutter_core(
    name = "app_core",
    srcs = ["lib/main.dart"],
    dart_plugin_registrant = "lib/dart_plugin_registrant.dart",
    entrypoint = "lib/main.dart",
    path_deps = [
        ":dev_only_probe_srcs",
        ":production_probe_srcs",
        ":shared_probe_srcs",
    ],
    platforms = [FLUTTER_ANDROID],
    pub = "@pub",
)

flutter_assets(
    name = "assets",
    assets = [],
    package_config = "@pub//:project_package_config.json",
    pub_srcs = ["@pub//:all"],
    pubspec = ":fixture_pubspec",
    target_platforms = ["@rules_android//:arm64-v8a"],
)

pub_path_deps_check(
    name = "fixture_path_deps_check",
    path_deps = [
        ":dev_only_probe_srcs",
        ":production_probe_srcs",
        ":shared_probe_srcs",
    ],
    pubspec_lock = "pubspec.lock",
)

build_test(
    name = "path_deps_validation_test",
    targets = [
        ":app_core",
        ":package",
    ],
)

