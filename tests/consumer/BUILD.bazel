# External-plugin regression: dependency recipes are ignored, and generated
# Maven labels use this project's mapping.

build_test(
    name = "namespace_plugin_test",
    targets = [
        # Each source package references its generated R class. An incorrect
        # custom_package (the namespace parser's output) therefore fails javac.
        "@flutter_plugins//namespace_bare:namespace_bare",
        "@flutter_plugins//namespace_call:namespace_call",
        "@flutter_plugins//namespace_assignment:namespace_assignment",
        "@flutter_plugins//namespace_guarded:namespace_guarded",
    ],
)

build_test(
    name = "fake_plugin_test",
    targets = [
        # Unlike every other fixture, this module names the repository
        # `plugin_maven`. Building the plugin verifies that `maven_repo` reaches
        # `maven_label()` through the caller's repository mapping.
        "@flutter_plugins//fake_plugin:fake_plugin",
        # The Kotlin-only fixture has no raw native libraries for this ABI.
        "@flutter_plugins//:native_files_arm64-v8a",
        "@flutter_plugins//build_config_plugin:build_config_plugin",
    ],
)

build_test(
    name = "recipe_plugin_maven_test",
    targets = ["@flutter_plugins//recipe_plugin:recipe_plugin"],
)

genrule(
    name = "build_config_plugin_jar_check",
    srcs = ["@flutter_plugins//build_config_plugin"],
    outs = ["build_config_plugin_jar.checked"],
    # Capture listings to avoid unzip's SIGPIPE when grep -q exits under pipefail.
    cmd = """set -eu
found=false
for archive in $(locations @flutter_plugins//build_config_plugin:build_config_plugin); do
  listing="$$(unzip -l "$$archive")"
  if grep -q 'com/example/build_config_plugin/BuildConfig.class' <<<"$$listing"; then
    found=true
  fi
  if grep -q 'classes.jar' <<<"$$listing"; then
    classes="$(@D)/build_config_plugin.classes.jar"
    unzip -p "$$archive" classes.jar > "$$classes"
    if grep -q 'com/example/build_config_plugin/BuildConfig.class' <<<"$$(unzip -l "$$classes")"; then
      found=true
    fi
  fi
done
test "$$found" = true
printf 'BuildConfig.class present in plugin jar\\n' > "$@"
""",
)

build_test(
    name = "build_config_plugin_jar_test",
    targets = [":build_config_plugin_jar_check"],
)

