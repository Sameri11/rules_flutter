"""The supported BUILD API for a Consumer Module.

Core rules load from @rules_flutter_core//flutter:defs.bzl. Android macros load from @rules_flutter_android//flutter:defs.bzl.
"""

load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_flutter_android//flutter:defs.bzl", "flutter_android_app", "flutter_assets", "flutter_native_contribution")
load(
    "@rules_flutter_core//flutter:defs.bzl",
    "flutter_core",
    "flutter_package",
    "flutter_pubspec",
    "flutter_test",
    "pub_path_deps_check",
    "pub_plugins_check",
)
load("@rules_java//java:defs.bzl", "java_binary", "java_import")
load(":embedding_deps.bzl", "EMBEDDING_DEPS")

package(default_visibility = ["//visibility:private"])

java_import(
    name = "flutter_embedding_no_plugins",
    jars = select({
        "@rules_flutter_core//flutter:mode_debug": ["@flutter_embedding_debug//jar:file"],
        "@rules_flutter_core//flutter:mode_release": ["@flutter_embedding_release//jar:file"],
    }),
    deps = EMBEDDING_DEPS,
    exports = EMBEDDING_DEPS,
    visibility = ["//visibility:public"],
)

exports_files(["build_config_probe.py"])

# The sources of the path plugin composed_app depends on. pub_path_deps_check
# requires every `path:` dependency's files to be declared, and a package cannot
# glob another package's directory.
filegroup(
    name = "composed_plugin_srcs",
    srcs = glob(["fixtures/composed_plugin/**"]),
    visibility = ["//composed_app:__pkg__"],
)

filegroup(
    name = "cmake_plugin_srcs",
    srcs = glob(["fixtures/cmake_plugin/**"]),
    visibility = ["//composed_app:__pkg__"],
)

filegroup(
    name = "recipe_package_srcs",
    srcs = glob(["fixtures/recipe_package/**"]),
    visibility = ["//composed_app:__pkg__"],
)

filegroup(
    name = "dev_cmake_plugin_srcs",
    srcs = glob(["fixtures/dev_cmake_plugin/**"]),
    visibility = ["//composed_app:__pkg__"],
)

# `//standard_layout` exercises `flutter_core` defaults for standard-layout
# sources/assets while naming the remaining attributes explicitly.

# --- defs.bzl: the platform-independent half ---------------------------------

# The single entry point for every pubspec fact.
flutter_pubspec(
    name = "fixture_pubspec",
    src = "pubspec.yaml",
)

flutter_package(
    name = "package",
    pub = "@pub",
    pubspec = ":fixture_pubspec",
)

flutter_test(
    name = "package_test",
    src = "test/package_test.dart",
    app = ":package",
    # Manual: CI's --build_tests_only skips it. Analysed via :analysis_only.
    tags = ["manual"],
)

# The macro, with every named parameter supplied -- it is the public entry point
# most consumers use, and its signature is the thing most likely to drift.
flutter_core(
    name = "app_core",
    srcs = ["lib/main.dart"],
    dart_plugin_registrant = "lib/registrant.dart",
    entrypoint = "lib/main.dart",
    path_deps = [],
    pub = "@pub",
)

flutter_assets(
    name = "assets",
    abis = ["arm64-v8a"],
    assets = [],
    package_config = "@pub//:project_package_config.json",
    pub_srcs = ["@pub//:all"],
    pubspec = ":fixture_pubspec",
)

pub_path_deps_check(
    name = "path_deps_check",
    path_deps = [],
    pubspec_lock = "pubspec.lock",
)

pub_plugins_check(
    name = "plugins_check",
    committed = "pubspec.yaml",
    expected = "pubspec.yaml",
)

# Recipe contributions stay a platform-neutral declaration. The composed
# plugin repository carries them through the raw per-ABI native file route.
flutter_native_contribution(
    name = "recipe_contribution",
    code_assets = {"package:fake/fake.dart": "libfake.so"},
    libraries = {"arm64-v8a": "fixtures/libfake.so"},
)

flutter_native_contribution(
    name = "recipe_contribution_ios",
    code_assets = {"package:fake/fake.dart": "fake.framework/fake"},
    libraries = {"ios-arm64_x86_64-simulator": "fixtures/fake.framework/fake"},
    platform = "ios",
)

flutter_native_contribution(
    name = "recipe_contribution_empty",
    empty = True,
)

flutter_android_app(
    name = "apk",
    core = ":app_core",
    manifest = "fixtures/AndroidManifest.xml",
    manifest_values = {"applicationId": "com.example.consumer_test"},
    plugins = "@flutter_plugins",
    resource_files = [],
    tags = ["manual"],
)

flutter_android_app(
    name = "apk_derived",
    core = ":app_core",
    manifest = "fixtures/AndroidManifest.xml",
    manifest_values = {"applicationId": "com.example.consumer_test"},
    plugins = "@flutter_plugins",
    resource_files = [],
    tags = ["manual"],
)

flutter_android_app(
    name = "apk_no_plugin_natives",
    core = ":app_core",
    manifest = "fixtures/AndroidManifest.xml",
    manifest_values = {"applicationId": "com.example.consumer_test"},
    plugins = None,
    resource_files = [],
    tags = ["manual"],
)

# Manual APKs are included in wildcard analysis without forcing their SDK actions.
filegroup(
    name = "analysis_only",
    testonly = True,
    srcs = [
        ":apk",
        ":apk_derived",
        ":apk_no_plugin_natives",
        ":apk_no_plugin_graph",
        ":apk_external_app",
        ":package_test",
    ],
)

flutter_android_app(
    name = "apk_no_plugin_graph",
    core = "//standard_layout:core",
    manifest = "fixtures/AndroidManifest.xml",
    manifest_values = {"applicationId": "com.example.consumer_test"},
    plugins = None,
    resource_files = [],
    tags = ["manual"],
)

flutter_android_app(
    name = "apk_external_app",
    core = "@external_app//app:app",
    manifest = "fixtures/AndroidManifest.xml",
    manifest_values = {"applicationId": "com.example.external_app"},
    plugins = None,
    resource_files = [],
    tags = ["manual"],
)

genrule(
    name = "apk_external_app_contents_check",
    srcs = [":apk_external_app.apk"],
    outs = ["apk_external_app_contents.checked"],
    cmd = """set -euo pipefail
value="$$(unzip -p $(location :apk_external_app.apk) assets/flutter_assets/assets/external-marker.txt)"
test "$$value" = "external app marker"
printf 'checked external app asset\\n' > "$@"
""",
)

build_test(
    name = "apk_external_app_contents_test",
    targets = [":apk_external_app_contents_check"],
)
# External-plugin regression: dependency recipes are ignored, and generated
# Maven labels use this project's mapping.
pub_plugins_check(
    name = "fake_plugin_deps_check",
    committed = "fixtures/plugin_deps.MODULE.bazel",
    expected = "@flutter_plugins//:plugin_deps.MODULE.bazel",
)

build_test(
    name = "namespace_plugin_test",
    targets = [
        # Each source package references its generated R class. An incorrect
        # custom_package (the namespace parser's output) therefore fails javac.
        "@flutter_plugins//namespace_bare:namespace_bare",
        "@flutter_plugins//namespace_call:namespace_call",
        "@flutter_plugins//namespace_assignment:namespace_assignment",
        "@flutter_plugins//namespace_guarded:namespace_guarded",
    ],
)

build_test(
    name = "fake_plugin_test",
    targets = [
        # Unlike every other fixture, this module names the repository
        # `plugin_maven`. Building the plugin verifies that `maven_repo` reaches
        # `maven_label()` through the caller's repository mapping.
        "@flutter_plugins//fake_plugin:fake_plugin",
        # The Kotlin-only fixture has no raw native libraries for this ABI.
        "@flutter_plugins//:native_files_arm64-v8a",
        "@flutter_plugins//build_config_plugin:build_config_plugin",
    ],
)

genrule(
    name = "build_config_plugin_jar_check",
    srcs = ["@flutter_plugins//build_config_plugin"],
    outs = ["build_config_plugin_jar.checked"],
    # Capture listings to avoid unzip's SIGPIPE when grep -q exits under pipefail.
    cmd = """set -eu
found=false
for archive in $(locations @flutter_plugins//build_config_plugin:build_config_plugin); do
  listing="$$(unzip -l "$$archive")"
  if grep -q 'com/example/build_config_plugin/BuildConfig.class' <<<"$$listing"; then
    found=true
  fi
  if grep -q 'classes.jar' <<<"$$listing"; then
    classes="$(@D)/build_config_plugin.classes.jar"
    unzip -p "$$archive" classes.jar > "$$classes"
    if grep -q 'com/example/build_config_plugin/BuildConfig.class' <<<"$$(unzip -l "$$classes")"; then
      found=true
    fi
  fi
done
test "$$found" = true
printf 'BuildConfig.class present in plugin jar\\n' > "$@"
""",
)

build_test(
    name = "build_config_plugin_jar_test",
    targets = [":build_config_plugin_jar_check"],
)

java_binary(
    name = "build_config_plugin_values",
    srcs = ["fixtures/BuildConfigValues.java"],
    main_class = "com.example.consumer.BuildConfigValues",
    deps = [
        "//composed_app:direct_embedding",
        "@flutter_plugins//build_config_plugin",
    ],
)

genrule(
    name = "build_config_plugin_values_check",
    outs = ["build_config_plugin_values.checked"],
    cmd = select({
        "@rules_flutter_core//flutter:mode_debug": """set -eu
actual="$$( $(location :build_config_plugin_values) )"
test "$$actual" = "true:debug:com.example.build_config_plugin:explicit-value:1.2.3:true:127:-32768:2147483640:9223372036854775807:3.4028235E38:4.9E-324"
printf '%s\\n' "$$actual" > "$@"
""",
        "@rules_flutter_core//flutter:mode_release": """set -eu
actual="$$( $(location :build_config_plugin_values) )"
test "$$actual" = "false:release:com.example.build_config_plugin:explicit-value:1.2.3:true:127:-32768:2147483640:9223372036854775807:3.4028235E38:4.9E-324"
printf '%s\\n' "$$actual" > "$@"
""",
    }),
    tools = [":build_config_plugin_values"],
)

build_test(
    name = "build_config_plugin_values_test",
    targets = [":build_config_plugin_values_check"],
)

