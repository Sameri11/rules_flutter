module(
    name = "consumer_test",
    version = "0.0.1",
)

bazel_dep(name = "flutter_bazel", version = "0.1.0")
bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "external_app", version = "0.0.1")

# For the java_import stubs flutter_android_libs is handed below.
bazel_dep(name = "rules_java", version = "9.3.0")

# Direct dependency for the Label-typed CPU constraint assertions below.
bazel_dep(name = "platforms", version = "1.0.0")

# The no-plugin fixture still packages Flutter's Android embedding, whose
# AndroidX runtime graph must be resolved by the consuming project.
bazel_dep(name = "rules_jvm_external", version = "7.1")

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    name = "flutter_maven",
    artifacts = [
        "androidx.lifecycle:lifecycle-common:2.7.0",
        "androidx.lifecycle:lifecycle-common-java8:2.7.0",
        "androidx.lifecycle:lifecycle-process:2.7.0",
        "androidx.lifecycle:lifecycle-runtime:2.7.0",
        "androidx.fragment:fragment:1.7.1",
        "androidx.annotation:annotation:1.8.1",
        "androidx.tracing:tracing:1.2.0",
        "androidx.core:core:1.13.1",
        "androidx.window:window-java:1.2.0",
        "androidx.window:window:1.2.0",
        "androidx.exifinterface:exifinterface:1.4.1",
        "com.getkeepsafe.relinker:relinker:1.4.5",
    ],
    repositories = [
        "https://maven.google.com",
        "https://repo1.maven.org/maven2",
    ],
    version_conflict_policy = "pinned",
)

# Keep this coordinate out of @flutter_maven so a hardcoded repo label fails.
maven.install(
    name = "plugin_maven",
    artifacts = [
        "androidx.annotation:annotation-experimental:1.4.1",
    ],
    repositories = [
        "https://maven.google.com",
        "https://repo1.maven.org/maven2",
    ],
    version_conflict_policy = "pinned",
)
use_repo(maven, "flutter_maven", "plugin_maven")

local_path_override(
    module_name = "flutter_bazel",
    path = "../..",
)

local_path_override(
    module_name = "external_app",
    path = "external_app",
)

# `external_app` supplies the unmatched dependency recipe now that the demo is
# a separate module outside this graph. The distinct `plugin_maven` repository
# also verifies that generated labels resolve through this module's mapping.
fake_plugin_metadata = use_repo_rule("//:fixtures/plugin_fixture.bzl", "fake_plugin_metadata")

fake_plugin_metadata(
    name = "fake_plugin_metadata",
    marker = "//:fixtures/fake_plugin/pubspec.yaml",
)

plugins = use_extension("@flutter_bazel//tools/flutter:plugins.bzl", "flutter_plugins_ext")
plugins.project(
    abis = ["arm64-v8a"],
    embedding = "//:flutter_embedding_no_plugins",
    maven_repo = "@plugin_maven//:pin",
    metadata = "@fake_plugin_metadata//:.flutter-plugins-dependencies",
    package_config = "@fake_plugin_metadata//:package_config.json",
)
use_repo(plugins, "flutter_plugins")

flutter = use_extension("@flutter_bazel//tools/flutter:repo.bzl", "flutter")
use_repo(flutter, "flutter_embedding_debug", "flutter_embedding_release", "flutter_sdk")
