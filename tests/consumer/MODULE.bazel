module(
    name = "consumer_test",
    version = "0.0.1",
)

bazel_dep(name = "sameri11_rules_flutter", version = "0.1.0", repo_name = "rules_flutter")
bazel_dep(name = "bazel_skylib", version = "1.8.2")

local_path_override(
    module_name = "sameri11_rules_flutter",
    path = "../..",
)

flutter = use_extension("@rules_flutter//flutter:extensions.bzl", "flutter")
flutter.sdk(version = "3.47.3")

# Separate pub hubs for the root fixtures and standard-layout app.
pub = use_extension("@rules_flutter//flutter:extensions.bzl", "pub")
pub.lock(
    name = "pub",
    lock = "//:pubspec.lock",
)
pub.lock(
    name = "standard_layout_pub",
    lock = "//standard_layout:pubspec.lock",
)
use_repo(pub, "pub", "standard_layout_pub")

include("//android:config.MODULE.bazel")
