load("@rules_flutter_android//flutter:defs.bzl", "FLUTTER_ANDROID", "flutter_android_app")
load("@rules_flutter_core//flutter:defs.bzl", "flutter_core")
load("//fake_platform:defs.bzl", "FLUTTER_FAKE")
load("//fake_platform:fake_app.bzl", "flutter_fake_app")

package(default_visibility = ["//visibility:public"])

flutter_core(
    name = "core",
    platforms = [
        FLUTTER_ANDROID,
        FLUTTER_FAKE,
    ],
    pub = "@mixed_pub",
)

flutter_fake_app(
    name = "fake_app",
    core = ":core",
)

flutter_android_app(
    name = "android_app",
    core = ":core",
    manifest = "AndroidManifest.xml",
    manifest_values = {"applicationId": "com.example.mixed_platform"},
    plugins = None,
    resource_files = [],
)
