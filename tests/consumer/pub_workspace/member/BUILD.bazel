load("@rules_flutter_core//flutter:defs.bzl", "flutter_package", "flutter_pubspec", "flutter_test")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "srcs",
    srcs = glob(["lib/**/*.dart"]),
)

flutter_pubspec(
    name = "pubspec",
    src = "pubspec.yaml",
)

flutter_package(
    name = "package",
    path_deps = [
        "//:dev_only_probe_srcs",
        "//pub_workspace/member_b:srcs",
    ],
    pub = "@workspace_pub",
    pubspec = ":pubspec",
)

flutter_test(
    name = "package_test",
    src = "test/member_test.dart",
    app = ":package",
)
