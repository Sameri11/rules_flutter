load("//flutter/private:test_kernel_driver.bzl", "driver_dill")
load(":pins_test.bzl", "pins_test_suite")

package(default_visibility = [
    "//flutter:__subpackages__",
    "//tests:__subpackages__",
])

exports_files(["driver.dart"])

# Built only when something depends on it: fetching the SDK and native sources is not free, so the
# toolchain does not reference this target.
driver_dill(
    name = "driver",
    srcs = ["@test_kernel_driver_src//:srcs"],
    driver = "@test_kernel_driver_src//:driver.dart",
)

# Selects the worker compiler's driver, so frontend_server never loads the driver's sources.
config_setting(
    name = "worker_compiler",
    flag_values = {"//flutter:test_kernel_compiler": "worker"},
)

# Empty for frontend_server, which then loads nothing from the driver package.
filegroup(name = "no_driver")

alias(
    name = "compiler_driver",
    actual = select({
        ":worker_compiler": ":driver",
        "//conditions:default": ":no_driver",
    }),
)

pins_test_suite(name = "pins_test")
