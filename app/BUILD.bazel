# The Dart half of the demo app: one call, everything else derived from the
# layout `flutter create` and `flutter pub get` produced.
#
# What used to be here -- the source glob, the entrypoint, the package config,
# the pub stamp triple, the committed Dart registrant, the pubspec target, three
# guards and their build_test -- is all default. Only the two facts about *this*
# app are stated below.

load("//tools/flutter:defs.bzl", "flutter_app")

package(default_visibility = ["//visibility:public"])

flutter_app(
    # Explicit and always a list -- there is no default, because one would mean
    # shipping a single ABI, or three, without saying which. Produces
    # //app:app_<abi>, and //app:assets carrying all three.
    abis = [
        "arm64-v8a",
        "x86_64",
        "armeabi-v7a",
    ],
    # Also emit //app:app_debug_kernel and //app:assets_debug. Local-only
    # artifacts: a debug kernel ships verbatim with this machine's paths in it.
    debug = True,
    # path: dependencies are listed in pubspec.lock but carry no content hash,
    # so their sources are declared -- and //app:path_deps_check fails the build
    # if one is missing.
    path_deps = ["//packages/mylib:srcs"],
)
