load(
    "//tools/flutter:defs.bzl",
    "dart_kernel",
    "flutter_assets",
    "flutter_aot_library",
    "pub_path_deps_check",
    "pub_plugins_check",
)

package(default_visibility = ["//visibility:public"])

PUB_STAMP = [
    ".dart_tool/version",
    ".dart_tool/package_graph.json",
    # sha256 per hosted package: makes content differences visible in the
    # action key, not just version-string differences.
    "pubspec.lock",
]

SRCS = glob(["lib/**/*.dart"])

# path: dependencies -- invisible to pubspec.lock, so declared explicitly.
PATH_DEPS = ["//packages/mylib:srcs"]

# Registers the Dart half of federated plugins. Generated from the same
# .flutter-plugins-dependencies as the native targets, then committed into lib/
# so it is addressable by a package: URI -- see dart_plugin_registrant_uri.
# //app:plugins_check fails if it drifts from what the plugin set implies.
DART_PLUGIN_REGISTRANT_URI = "package:demo_app/dart_plugin_registrant.dart"

# --- release: remote-cacheable ------------------------------------------------

flutter_aot_library(
    name = "app",
    srcs = SRCS,
    entrypoint_uri = "package:demo_app/main.dart",
    package_config = ".dart_tool/package_config.json",
    path_deps = PATH_DEPS,
    pub_stamp = PUB_STAMP,
    dart_plugin_registrant_uri = DART_PLUGIN_REGISTRANT_URI,
)

flutter_assets(
    name = "assets",
    srcs = SRCS,
    assets = glob(["assets/**"]),
    package_config = ".dart_tool/package_config.json",
    pub_stamp = PUB_STAMP,
    path_deps = PATH_DEPS,
    pubspec = "pubspec.yaml",
)

# --- debug: local only, never shared ------------------------------------------

dart_kernel(
    name = "app_debug_kernel",
    srcs = SRCS,
    entrypoint_uri = "package:demo_app/main.dart",
    mode = "debug",
    package_config = ".dart_tool/package_config.json",
    path_deps = PATH_DEPS,
    pub_stamp = PUB_STAMP,
    dart_plugin_registrant_uri = DART_PLUGIN_REGISTRANT_URI,
)

flutter_assets(
    name = "assets_debug",
    srcs = SRCS,
    assets = glob(["assets/**"]),
    mode = "debug",
    package_config = ".dart_tool/package_config.json",
    pub_stamp = PUB_STAMP,
    path_deps = PATH_DEPS,
    pubspec = "pubspec.yaml",
)

# Guard: fails if the committed MODULE.bazel segment no longer matches the
# Maven coordinates the plugins declare -- e.g. after adding or upgrading one.
pub_plugins_check(
    name = "plugins_check",
    committed = "//:plugin_deps.MODULE.bazel",
    expected = "@flutter_plugins//:plugin_deps.MODULE.bazel",
)

# Guard: the Dart registrant is committed into lib/ rather than consumed from
# the generated repo, because only a file inside the package config has a
# package: URI -- and the URI has to be machine-independent, since the engine
# looks the library up by that exact string at runtime.
pub_plugins_check(
    name = "dart_registrant_check",
    committed = "lib/dart_plugin_registrant.dart",
    expected = "@flutter_plugins//:dart_plugin_registrant.dart",
)

# Guard: fails if a path: dependency is missing from PATH_DEPS.
pub_path_deps_check(
    name = "path_deps_check",
    path_deps = PATH_DEPS,
    pubspec_lock = "pubspec.lock",
)
