# Bazel target for the Android module that `flutter create` generated, placed
# beside the Gradle module it mirrors so both read the same manifest, resources
# and sources. Nothing here is a copy.
#
# Note this directory is template-managed: `flutter create --platforms` and
# `flutter migrate` rewrite files under app/android/. They do not delete unknown
# files, so this BUILD survives, but keep that in mind when upgrading templates.

load("@rules_android//rules:rules.bzl", "android_binary", "android_library")
load("@rules_kotlin//kotlin:android.bzl", "kt_android_library")
load("//tools/flutter:android.bzl", "flutter_android_libs", "flutter_assets_dir")
load("//tools/flutter:embedding.bzl", "flutter_embedding_deps", "flutter_embedding_library")

package(default_visibility = ["//visibility:public"])

# Every plugin `pub get` reported as having an Android native build. The
# aggregate is generated from .flutter-plugins-dependencies, so adding a plugin
# to pubspec.yaml is the only step -- see //tools/flutter:plugins.bzl.
PLUGINS = ["@flutter_plugins//:all"]

# The Flutter asset bundle. Named once: android_binary needs both the target and
# the path prefix it sits under, and those must agree.
ASSETS = "//app:assets"

# The engine jar with its AndroidX dependencies attached. Instantiated here, in
# the app, rather than inside the rules: its deps come from @flutter_maven, which
# this project's MODULE.bazel creates from this project's plugin coordinates. A
# label naming it from inside //tools/flutter would resolve against the *rules'*
# dependencies instead -- which is exactly the bug that made these rules
# unusable as a bazel_dep. See //tools/flutter:embedding.bzl.
flutter_embedding_library(name = "flutter_embedding")

# Every Flutter contribution to the APK, joined into one target: the AOT
# snapshot, the engine, the runtime classes, the assets, the plugin libraries,
# the recipe libraries and the registrant. Each is named, and a bundle check
# fails the build if one goes missing -- see //tools/flutter:bundle.bzl.
#
# The pieces are supplied rather than resolved in the macro because they belong
# to this project: :flutter_embedding and its Maven deps come from this
# project's own resolution, and @flutter_plugins is generated from this
# project's pubspec.
flutter_android_libs(
    name = "flutter",
    aot = "//app:app_arm64-v8a",
    assets = ASSETS,
    embedding = ":flutter_embedding",
    embedding_deps = flutter_embedding_deps(),
    engine_jar = "@flutter_engine_arm64//jar:file",
    native_libs = "@flutter_plugins//:native_libs",
    plugins = PLUGINS[0],
    registrant = ":generated_plugin_registrant",
)

# Note: no debug-symbol artifact is produced. Stripping discards the engine's
# DWARF rather than saving it, so there is nothing here to upload to a
# crash-reporting service yet. See docs/android-packaging.md.

# The plugin registrant flutter_tools regenerates on every `pub get`, consumed
# in place from the Gradle module like the manifest and resources rather than
# copied.
#
# This is its own target rather than another src on :main_activity because its
# deps *are* the plugin list: registerWith() instantiates each plugin class, so
# every //plugins:* target will attach here as coverage grows. Keeping it apart
# also keeps MainActivity as what `flutter create` generated.
#
# Nothing calls this class. FlutterEngine locates it reflectively --
# GeneratedPluginRegister does Class.forName("io.flutter.plugins.Generated\
# PluginRegistrant") then getDeclaredMethod("registerWith") -- so it needs no
# call site, only presence in the dex, and @Keep becomes load bearing the moment
# shrinking is turned on. A missing registrant is logged at error level and the
# app carries on with dead plugins:
#   E GeneratedPluginsRegister: java.lang.ClassNotFoundException: io.flutter.
#   plugins.GeneratedPluginRegistrant
# so absence is invisible to any launch-succeeded check. Verify by class
# definition in the dex, not by `strings` -- the reflection literal and the log
# message both match the name in an APK that does not contain the class.
android_library(
    name = "generated_plugin_registrant",
    srcs = ["src/main/java/io/flutter/plugins/GeneratedPluginRegistrant.java"],
    deps = PLUGINS + [
        ":flutter_embedding",
        # @Keep / @NonNull. java_import deps are not re-exported to a consumer's
        # compile classpath, so this is declared here rather than inherited
        # through :flutter_embedding.
        #
        # ...and it is the _jvm artifact, not the bare one. androidx.annotation
        # became a KMP module at 1.7: `androidx.annotation:annotation` is now
        # metadata-only and carries no class files, so it satisfies runtime
        # resolution (which follows the pom to annotation-jvm) but not a strict
        # compile classpath. Same family as the window/window-java split noted
        # in MODULE.bazel.
        "@flutter_maven//:androidx_annotation_annotation_jvm",
    ],
)

android_binary(
    name = "demo_app",
    assets = [ASSETS],
    # Derived, not written out: the prefix has to match where the tree
    # artifact sits, and a wrong one fails only at runtime.
    assets_dir = flutter_assets_dir(assets = ASSETS),
    # The manifest and resources `flutter create` generated are used directly,
    # rather than copied. A copy drifts, and drift is what produced the
    # missing-theme and targetSdk defects.
    manifest = "src/main/AndroidManifest.xml",
    # Values AGP would supply from build.gradle.kts, which the manifest itself
    # does not carry: ${applicationName} is a placeholder, and the package and
    # SDK levels live in the gradle `namespace` / `minSdk` / `targetSdk`.
    # targetSdk 36 matches flutter_tools (FlutterExtension.kt) and is what
    # enables edge-to-edge on Android 15+.
    manifest_values = {
        "applicationId": "com.example.demo_app",
        "applicationName": "io.flutter.app.FlutterApplication",
        "minSdkVersion": "21",
        "targetSdkVersion": "36",
    },
    resource_files = glob(["src/main/res/**"]),
    # The host application, and one Flutter target. Every Flutter dependency
    # arrives through :flutter; the asset tree stays an attribute above -- see
    # flutter_android_libs for why.
    deps = [
        # Order decides where native libraries land in the zip, and a .so is
        # stored uncompressed and page-aligned, so moving one shifts padding.
        # Host application first, as this file listed before the contributions
        # were joined, so the APK stays comparable by hash. Nothing functional
        # depends on it -- Android resolves lib/<abi>/*.so by name.
        #
        # This comment also preserves the order: buildifier sorts a list only
        # when it carries none.
        ":main_activity",
        ":flutter",
    ],
)

# The generated manifest names ".MainActivity".
# The Kotlin MainActivity that `flutter create` generated, compiled directly.
# kt_android_library rather than kt_jvm_library: the class extends Activity, so
# it needs android.jar on the compile classpath.
kt_android_library(
    name = "main_activity",
    srcs = ["src/main/kotlin/com/example/demo_app/MainActivity.kt"],
    deps = [":flutter_embedding"],
)
