# sbm_ffi cdylib for the four tests that load it from cwd (`target/debug/libsbm_ffi.dylib`, test/rust_lib_helper.dart).
# Not hermetic: uses the host cargo and its registry.
genrule(
    name = "sbm_ffi_dylib",
    srcs = glob(["Cargo.toml", "Cargo.lock", "crates/**", "monitor/**"]),
    outs = ["target/debug/libsbm_ffi.dylib", "target/debug/libsbm_ffi.so"],
    cmd = """
set -eo pipefail
export HOME="$$(echo ~)"  # Bazel's genrule env has no HOME; rustup needs it
export PATH="$$HOME/.cargo/bin:$$PATH" RUSTUP_TOOLCHAIN=1.97.1  # crates/sbm_ffi/rust-toolchain.toml
cargo build -p sbm_ffi --target-dir "$(RULEDIR)/cargo" --quiet
# Each host writes its own shared library; the other output is an empty placeholder.
for ext in dylib so; do
  if [ -f "$(RULEDIR)/cargo/debug/libsbm_ffi.$$ext" ]; then
    cp "$(RULEDIR)/cargo/debug/libsbm_ffi.$$ext" "$(RULEDIR)/target/debug/libsbm_ffi.$$ext"
  else
    : > "$(RULEDIR)/target/debug/libsbm_ffi.$$ext"
  fi
done
""",
    local = True,
)
