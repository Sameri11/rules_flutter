load("@rules_flutter//flutter:defs.bzl", "flutter_app", "flutter_test")

package(default_visibility = ["//visibility:public"])

exports_files(["plugin_deps.MODULE.bazel"])

# The lockfile records these path dependencies without content hashes. Keep
# every package's Dart declaration and source in the app action key.
filegroup(
    name = "circle_chart_srcs",
    srcs = glob(["packages/circle_chart/lib/**/*.dart"]) + ["packages/circle_chart/pubspec.yaml"],
)

filegroup(
    name = "dartssh2_srcs",
    srcs = glob(["packages/dartssh2/lib/**/*.dart"]) + ["packages/dartssh2/pubspec.yaml"],
)

filegroup(
    name = "fl_build_srcs",
    srcs = glob(["packages/fl_build/lib/**/*.dart"]) + ["packages/fl_build/pubspec.yaml"],
)

filegroup(
    name = "fl_lib_srcs",
    srcs = glob(["packages/fl_lib/lib/**/*.dart"]) + ["packages/fl_lib/pubspec.yaml"],
)

filegroup(
    name = "flutter_pty_srcs",
    srcs = glob([
        "packages/flutter_pty/hook/**",
        "packages/flutter_pty/lib/**/*.dart",
        "packages/flutter_pty/src/**",
    ]) + ["packages/flutter_pty/pubspec.yaml"],
)

filegroup(
    name = "plain_notification_token_srcs",
    srcs = glob(["packages/plain_notification_token/lib/**/*.dart"]) + ["packages/plain_notification_token/pubspec.yaml"],
)

filegroup(
    name = "redfish_srcs",
    srcs = glob(["packages/redfish/lib/**/*.dart"]) + ["packages/redfish/pubspec.yaml"],
)

filegroup(
    name = "watch_connectivity_srcs",
    srcs = glob(["packages/watch_connectivity/lib/**/*.dart"]) + ["packages/watch_connectivity/pubspec.yaml"],
)

filegroup(
    name = "xterm_srcs",
    srcs = glob(["packages/xterm/lib/**/*.dart"]) + ["packages/xterm/pubspec.yaml"],
)

# Git dependencies are vendored as path packages (rules refuse git sources).
filegroup(
    name = "third_party_git_srcs",
    srcs = glob(["third_party/git/**/*.dart", "third_party/git/**/pubspec.yaml", "third_party/git/**/assets/**"], allow_empty = True),
)

_PATH_DEPS = [
    ":circle_chart_srcs",
    ":dartssh2_srcs",
    ":fl_build_srcs",
    ":fl_lib_srcs",
    ":flutter_pty_srcs",
    ":plain_notification_token_srcs",
    ":redfish_srcs",
    ":watch_connectivity_srcs",
    ":xterm_srcs",
    ":third_party_git_srcs",
]

flutter_app(
    abis = ["arm64-v8a"],
    path_deps = _PATH_DEPS,
    pub = "@pub",
)

