"""Consumer recipe for the current url_launcher Android implementation."""

load("@rules_flutter//flutter:defs.bzl", "flutter_native_contribution")
load("@rules_kotlin//kotlin:android.bzl", "kt_android_library")

_BUILD_CONFIG = """// Generated by //bazel/flutter:serverbox_fixes.bzl.
package {package};

public final class BuildConfig {{
    public static final boolean DEBUG = false;
}}
"""


def _no_native(name):
    flutter_native_contribution(
        name = name + "_flutter_native",
        empty = True,
    )


def _srcs(info, extension):
    return [
        f
        for f in info.all_files
        if f.startswith("android/src/main/") and f.endswith(extension)
    ]


def url_launcher_android_recipe(name, info):
    native.genrule(
        name = name + "_build_config",
        outs = ["BuildConfig.java"],
        cmd = "cat > $@ <<'EOF'\n" + _BUILD_CONFIG.format(package = info.namespace) + "EOF",
    )
    _no_native(name)
    kt_android_library(
        name = name,
        srcs = _srcs(info, ".java") + _srcs(info, ".kt") + [":" + name + "_build_config"],
        manifest = info.android_manifest,
        custom_package = info.namespace,
        exports_manifest = 1,
        resource_files = info.resource_files,
        deps = [info.embedding] + info.plugin_deps + info.coordinates,
    )
