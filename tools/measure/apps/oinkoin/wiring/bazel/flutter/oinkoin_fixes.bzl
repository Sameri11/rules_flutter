"""Consumer recipes for known Flutter plugin and native-asset gaps."""

load("@rules_flutter//flutter:defs.bzl", "flutter_native_contribution")
load("@rules_kotlin//kotlin:android.bzl", "kt_android_library")


def _no_native(name):
    flutter_native_contribution(name = name + "_flutter_native", empty = True)


def _srcs(info, extension):
    return [
        f
        for f in info.all_files
        if f.startswith("android/src/main/") and f.endswith(extension)
    ]


_BUILD_CONFIG = """// Generated by //bazel/flutter:oinkoin_fixes.bzl.
package {package};

public final class BuildConfig {{
    public static final boolean DEBUG = false;
}}
"""


def url_launcher_android_recipe(name, info):
    """Supply the BuildConfig class AGP generates for url_launcher_android."""
    native.genrule(
        name = name + "_build_config",
        outs = ["BuildConfig.java"],
        cmd = "cat > $@ <<'EOF'\n" + _BUILD_CONFIG.format(package = info.namespace) + "EOF",
    )
    _no_native(name)
    kt_android_library(
        name = name,
        srcs = _srcs(info, ".java") + _srcs(info, ".kt") + [":" + name + "_build_config"],
        manifest = info.android_manifest,
        custom_package = info.namespace,
        exports_manifest = 1,
        resource_files = info.resource_files,
        deps = [info.embedding] + info.plugin_deps + info.coordinates,
    )


def shared_preferences_android_recipe(name, info):
    """Compile against datastore-preferences' Android variant."""
    kt_android_library(
        name = name,
        srcs = _srcs(info, ".java") + _srcs(info, ".kt"),
        manifest = info.android_manifest,
        custom_package = info.namespace,
        exports_manifest = 1,
        resource_files = info.resource_files,
        deps = [info.embedding] + info.plugin_deps + info.coordinates,
    )
    _no_native(name)


def sqlite3_recipe(name, info):
    """Attach sqlite3's prebuilt arm64 Android native asset."""
    if info.is_plugin:
        fail("sqlite3 is not expected to be a Flutter plugin")
    if info.abis != ["arm64-v8a"]:
        fail("sqlite3_recipe supports only the declared arm64-v8a ABI")
    flutter_native_contribution(
        name = name + "_flutter_native",
        libraries = {"arm64-v8a": Label("@libsqlite3_android_arm64_v8a//file")},
        code_assets = {
            "package:sqlite3/src/ffi/libsqlite3.g.dart": "libsqlite3.so",
        },
    )
    native.filegroup(name = name, srcs = [])
