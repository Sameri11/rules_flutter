load("@buildifier_prebuilt//:rules.bzl", "buildifier", "buildifier_test")

# Keep the dev dependency out of consumer-loaded packages.

# `find -path` lets `*` span `/`, so these patterns cover both flat and
# monorepo example layouts. buildifier_prebuilt's ungrouped `-o` expression
# attaches `-prune` only to the final pattern; earlier patterns exclude matches
# but do not stop descent. Keep the largest generated tree last. The exclusions
# only save traversal because these trees contain no checked Starlark files.
_EXCLUDE_PATTERNS = [
    "./third_party/*",
    "./bazel-*",
    "./tests/consumer/bazel-*",
    "./examples/*/bazel-*",
    "./examples/*/.dart_tool/*",
    "./examples/*/.gradle/*",
    "./.git/*",
    # Last on purpose -- see above. Do not sort this list.
    "./examples/*/build/*",
]

buildifier(
    name = "buildifier",
    exclude_patterns = _EXCLUDE_PATTERNS,
    lint_mode = "fix",
    mode = "fix",
)

buildifier(
    name = "buildifier.check",
    exclude_patterns = _EXCLUDE_PATTERNS,
    lint_mode = "warn",
    mode = "check",
)

# Run buildifier under `bazel test` to check files outside the build graph.
buildifier_test(
    name = "buildifier_test",
    size = "small",
    exclude_patterns = _EXCLUDE_PATTERNS,
    lint_mode = "warn",
    mode = "check",
    # A whole-tree scan needs the workspace root and no sandbox.
    no_sandbox = True,
    workspace = "//:MODULE.bazel",
)
