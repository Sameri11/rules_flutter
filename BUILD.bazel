# The root package exists so MODULE.bazel can include() the generated plugin
# dependency segment, which requires it to be a label.
package(default_visibility = ["//visibility:public"])

# MODULE.bazel is exported purely as a workspace-root marker for
# //tools/format:buildifier_test, which needs a label in the root package to
# locate the tree it should check. Nothing reads its contents through this.
exports_files([
    "MODULE.bazel",
    "plugin_deps.MODULE.bazel",
])
