module(
    name = "local_plugin",
    version = "0.0.1",
)

# Monorepo app with a local path plugin. It exercises non-root metadata and
# plugin paths outside the pub cache.
bazel_dep(name = "sameri11_rules_flutter", version = "0.1.0", repo_name = "rules_flutter")
local_path_override(
    module_name = "sameri11_rules_flutter",
    path = "../..",
)

flutter = use_extension("@rules_flutter//flutter:extensions.bzl", "flutter")
flutter.sdk(version = "3.44.2")

# Fetch hosted dependencies from the lock.
pub = use_extension("@rules_flutter//flutter:extensions.bzl", "pub")
pub.lock(
    name = "pub",
    lock = "//packages/host_app:pubspec.lock",
)
use_repo(pub, "pub")

include("//packages/host_app/android:config.MODULE.bazel")
