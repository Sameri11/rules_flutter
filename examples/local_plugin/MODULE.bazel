module(
    name = "local_plugin",
    version = "0.0.1",
)

# macOS host C/C++ (protoc) must use apple_support's toolchain: Xcode 27 clang
# records the SDK's SDKSettings.json in every dependency file, which only
# apple_support's builtin include directories allow. Toolchains register in
# bazel_dep order, so declare it before anything that brings rules_cc's
# toolchain.
bazel_dep(name = "apple_support", version = "1.24.5")

# Monorepo app with a local path plugin. It exercises non-root metadata and
# plugin paths outside the pub cache.
bazel_dep(name = "sameri11_rules_flutter_core", version = "0.1.0", repo_name = "rules_flutter_core")
local_path_override(
    module_name = "sameri11_rules_flutter_core",
    path = "../../rules_flutter_core",
)

bazel_dep(name = "sameri11_rules_flutter_android", version = "0.1.0", repo_name = "rules_flutter_android")
local_path_override(
    module_name = "sameri11_rules_flutter_android",
    path = "../../rules_flutter_android",
)

flutter = use_extension("@rules_flutter_core//flutter:extensions.bzl", "flutter")
flutter.sdk(version = "3.47.3")
use_repo(flutter, "flutter_embedding_debug", "flutter_embedding_release")

# Fetch hosted dependencies from the lock.
pub = use_extension("@rules_flutter_core//flutter:extensions.bzl", "pub")
pub.lock(
    name = "pub",
    lock = "//packages/host_app:pubspec.lock",
)
use_repo(pub, "pub")

include("//packages/host_app/android:config.MODULE.bazel")
