load("@rules_flutter//flutter:defs.bzl", "flutter_assets_sdk_free", "flutter_package", "flutter_pubspec", "flutter_test")

package(default_visibility = ["//visibility:public"])

flutter_pubspec(name = "pubspec")

# The package's own flutter_package. Its dependencies come from the host app's hub,
# which resolves greeter as a path dependency.
flutter_package(
    name = "greeter",
    pub = "@pub",
    pubspec = ":pubspec",
    assets = ":core_assets",

)
# Package-level core artifact experiment; deliberately independent of the host app.
flutter_assets_sdk_free(
    name = "core_assets",
    abis = ["arm64-v8a"],
    assets = [],
    pubspec = ":pubspec",
    package_config = "@pub//:project_package_config.json",
    pub_srcs = ["@pub//:all"],
)

flutter_test(
    name = "greeter_test",
    src = "test/greeter_test.dart",
    app = ":greeter",
    # CI does not run example tests yet.
    tags = ["manual"],
)

# Declare path-dependency sources explicitly: pubspec.lock does not hash them.
# The plugin generator builds the Android half in @flutter_plugins.
filegroup(
    name = "srcs",
    srcs = glob(["lib/**/*.dart"]) + ["pubspec.yaml"],
)
