# Dart targets for the flat demo app. Standard flutter_app paths are derived
# from the flutter create layout.

load("@rules_flutter//flutter:defs.bzl", "flutter_app", "flutter_test", "flutter_test_suite")

package(default_visibility = ["//visibility:public"])

flutter_app(
    # A generated lib source, compiled with the package's other lib/ sources.
    srcs = glob(["lib/**/*.dart"]) + [":lib/gen_info.dart"],
    # Keep this list aligned with the Android target.
    abis = [
        "arm64-v8a",
        "x86_64",
        "armeabi-v7a",
    ],
    # Declare sources of the local path dependency.
    path_deps = ["//packages/mylib:srcs"],
    # The hub of pubspec.lock, declared in MODULE.bazel.
    pub = "@pub",
)

# The special tests below need their own settings, so they are declared by hand
# and added to the suite's tests.
flutter_test_suite(
    name = "tests",
    srcs = glob(
        ["test/**/*_test.dart"],
        exclude = [
            # The app calls rive_native at startup, and host tests load no
            # librive_native dylib; the test fails under flutter_tester.
            "test/widget_test.dart",
            "test/defines_test.dart",
            "test/generated_lib_test.dart",
            "test/materialize_test.dart",
        ],
    ),
    app = ":app",
    tests = [
        ":defines_test",
        ":generated_lib_test",
        ":materialize_test",
    ],
)

flutter_test(
    name = "materialize_test",
    src = "test/materialize_test.dart",
    app = ":app",
    data = glob(["test/fixtures/materialize/**"]),
    materialize = ["test/fixtures/materialize"],
)

flutter_test(
    name = "defines_test",
    src = "test/defines_test.dart",
    app = ":app",
    dart_defines = {"DEMO_FLAVOR": "staging"},
)

genrule(
    name = "gen_lib",
    outs = ["lib/gen_info.dart"],
    cmd = "echo \"const String generatedGreeting = 'generated';\" > $@",
)

flutter_test(
    name = "generated_lib_test",
    src = "test/generated_lib_test.dart",
    app = ":app",
)
