# Dart targets for the flat demo app. The core owns the standard Flutter package
# layout, and its outputs are composed into Android targets in android/app.

load("@rules_flutter_core//flutter:defs.bzl", "flutter_core", "flutter_test", "flutter_test_suite")

package(default_visibility = ["//visibility:public"])

flutter_core(
    name = "app",
    srcs = glob(["lib/**/*.dart"]) + [":lib/gen_info.dart"],
    native_build_env = "@rules_flutter_android//flutter:native_build_env",
    path_deps = ["//packages/mylib:srcs"],
    plugin_deps = "//:plugin_deps.MODULE.bazel",
    dart_plugin_registrant = "lib/dart_plugin_registrant.dart",
    pub = "@pub",
)

# The special tests below need their own settings, so they are declared by hand
# and added to the suite's tests.
flutter_test_suite(
    name = "tests",
    srcs = glob(
        ["test/**/*_test.dart"],
        exclude = [
            "test/defines_test.dart",
            "test/generated_lib_test.dart",
            "test/materialize_test.dart",
        ],
    ),
    app = ":app_test_package",
    tests = [
        ":defines_test",
        ":generated_lib_test",
        ":materialize_test",
    ],
)

flutter_test(
    name = "materialize_test",
    src = "test/materialize_test.dart",
    app = ":app_test_package",
    data = glob(["test/fixtures/materialize/**"]),
    materialize = ["test/fixtures/materialize"],
)

flutter_test(
    name = "defines_test",
    src = "test/defines_test.dart",
    app = ":app_test_package",
    dart_defines = {"DEMO_FLAVOR": "staging"},
)

genrule(
    name = "gen_lib",
    outs = ["lib/gen_info.dart"],
    cmd = "echo \"const String generatedGreeting = 'generated';\" > $@",
)

flutter_test(
    name = "generated_lib_test",
    src = "test/generated_lib_test.dart",
    app = ":app_test_package",
)
