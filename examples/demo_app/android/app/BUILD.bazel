# The Android module that `flutter create` generated, beside the Gradle module
# it mirrors so both read the same manifest, resources and sources.

load("@rules_flutter_android//flutter:defs.bzl", "flutter_android_app")
load("@rules_java//java:defs.bzl", "java_import")
load("@rules_kotlin//kotlin:android.bzl", "kt_android_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "flutter_embedding_jar",
    srcs = ["//:app"],
    output_group = "flutter_embedding",
)

java_import(
    name = "flutter_embedding",
    jars = [":flutter_embedding_jar"],
    exports = [
        "@flutter_maven//:androidx_annotation_annotation",
        "@flutter_maven//:androidx_annotation_annotation_jvm",
        "@flutter_maven//:androidx_core_core",
        "@flutter_maven//:androidx_exifinterface_exifinterface",
        "@flutter_maven//:androidx_fragment_fragment",
        "@flutter_maven//:androidx_lifecycle_lifecycle_common",
        "@flutter_maven//:androidx_lifecycle_lifecycle_common_java8",
        "@flutter_maven//:androidx_lifecycle_lifecycle_process",
        "@flutter_maven//:androidx_lifecycle_lifecycle_runtime",
        "@flutter_maven//:androidx_tracing_tracing",
        "@flutter_maven//:androidx_window_window",
        "@flutter_maven//:androidx_window_window_java",
        "@flutter_maven//:com_getkeepsafe_relinker_relinker",
    ],
    deps = [
        "@flutter_maven//:androidx_annotation_annotation",
        "@flutter_maven//:androidx_annotation_annotation_jvm",
        "@flutter_maven//:androidx_core_core",
        "@flutter_maven//:androidx_exifinterface_exifinterface",
        "@flutter_maven//:androidx_fragment_fragment",
        "@flutter_maven//:androidx_lifecycle_lifecycle_common",
        "@flutter_maven//:androidx_lifecycle_lifecycle_common_java8",
        "@flutter_maven//:androidx_lifecycle_lifecycle_process",
        "@flutter_maven//:androidx_lifecycle_lifecycle_runtime",
        "@flutter_maven//:androidx_tracing_tracing",
        "@flutter_maven//:androidx_window_window",
        "@flutter_maven//:androidx_window_window_java",
        "@flutter_maven//:com_getkeepsafe_relinker_relinker",
    ],
)

flutter_android_app(
    name = "demo_app",
    core = "//:app",
    manifest_values = {"applicationId": "com.example.demo_app"},
    plugins = "@flutter_plugins",
    # Keep dependency order stable: native library order affects ZIP alignment.
    deps = [":main_activity"],
)

# The generated manifest names ".MainActivity".
# The Kotlin MainActivity that `flutter create` generated, compiled directly.
# kt_android_library rather than kt_jvm_library: the class extends Activity, so
# it needs android.jar on the compile classpath.
kt_android_library(
    name = "main_activity",
    srcs = ["src/main/kotlin/com/example/demo_app/MainActivity.kt"],
    deps = [":demo_app_inputs"],
)
