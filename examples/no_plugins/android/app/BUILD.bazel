# Android targets for the plugin-free app.

load("@rules_flutter_android//flutter:defs.bzl", "flutter_android_app", "flutter_android_inputs")
load("@rules_kotlin//kotlin:android.bzl", "kt_android_library")

package(default_visibility = ["//visibility:public"])

flutter_android_inputs(
    name = "no_plugins_inputs",
    core = "//:core",
    plugins = None,
)

flutter_android_app(
    name = "no_plugins",
    inputs = ":no_plugins_inputs",
    manifest_values = {"applicationId": "com.example.no_plugins"},
    deps = [":main_activity"],
    test_apps = {
        "smoke": {
            "app": "//:core",
            "entrypoint": "//integration_test:debug_core_test.dart",
            "srcs": ["//integration_test:debug_core_helper.dart"],
            "dart_defines": {"DEBUG_CORE_MARK": "test-value"},
        },
        "prebuilt": {"core": "//integration_test:prebuilt_core"},
        "suffix": {
            "app": "//:core",
            "entrypoint": "//integration_test:debug_core_test.dart",
            "srcs": ["//integration_test:debug_core_helper.dart"],
            "dart_defines": {"DEBUG_CORE_MARK": "suffix-value"},
            "manifest": "//integration_test:identity_manifest.xml",
            "manifest_values": {"applicationId": "com.example.no_plugins.test"},
        },
        "flutter_activity": {
            "app": "//:core",
            "entrypoint": "//integration_test:debug_core_test.dart",
            "srcs": ["//integration_test:debug_core_helper.dart"],
            "dart_defines": {"DEBUG_CORE_MARK": "activity-value"},
            "manifest": "//integration_test:flutter_activity_manifest.xml",
        },
    },
)

kt_android_library(
    name = "main_activity",
    srcs = ["src/main/kotlin/com/example/no_plugins/MainActivity.kt"],
    deps = [":no_plugins_inputs"],
)


