<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.example.no_plugins">
    <application android:label="No plugins">
        <activity android:name="io.flutter.embedding.android.FlutterActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
