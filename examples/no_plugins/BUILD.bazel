# Dart targets for a plugin-free app.

load("@rules_flutter_core//flutter:defs.bzl", "flutter_core", "flutter_integration_test", "flutter_test_suite")

package(default_visibility = ["//visibility:public"])

flutter_core(
    name = "core",
    srcs = glob(["lib/**/*.dart"]),
    # flutter create declares no assets.
    assets = [],
    native_build_env = "@rules_flutter_android//flutter:native_build_env",
    pub = "@pub",
)

flutter_integration_test(
    name = "integration_pass",
    app = ":core",
    src = "//integration_test:integration_pass_test.dart",
    data = ["//integration_test:runner_data.txt"],
    env = {"RUNNER_FIXTURE": "available"},
)


flutter_integration_test(
    name = "integration_fail",
    app = ":core",
    src = "//integration_test:integration_fail_test.dart",
)

flutter_integration_test(
    name = "integration_lifecycle",
    app = ":core",
    src = "//integration_test:integration_lifecycle_test.dart",
)

flutter_integration_test(
    name = "integration_timeout",
    app = ":core",
    src = "//integration_test:integration_timeout_test.dart",
)

flutter_integration_test(
    name = "integration_crash",
    app = ":core",
    src = "//integration_test:integration_crash_test.dart",
)

flutter_integration_test(
    name = "integration_deadline",
    app = ":core",
    src = "//integration_test:integration_deadline_test.dart",
)

# The host test reads core_test_package, declared by flutter_core for the
# tester platform: no Android build environment is needed.
flutter_test_suite(
    name = "tests",
    app = ":core_test_package",
)
