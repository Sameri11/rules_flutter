# Dart targets for a plugin-free app.

load("@rules_flutter//flutter:defs.bzl", "flutter_app", "flutter_assets_sdk_free", "flutter_assets_tester", "flutter_package", "flutter_test", "flutter_test_suite")

package(default_visibility = ["//visibility:public"])

flutter_app(
    # Keep this fixture single-ABI.
    abis = ["arm64-v8a"],
    # flutter create declares no assets.
    assets = [],
    plugin_deps = None,
    pub = "@pub",
)

flutter_assets_sdk_free(
    name = "assets_sdk_free",
    abis = ["arm64-v8a"],
    assets = [],
    pubspec = ":pubspec",
    package_config = "@pub//:project_package_config.json",
    pub_srcs = ["@pub//:all"],
)

flutter_assets_tester(
    name = "assets_tester",
    abis = [],
    assets = [],
    pubspec = ":pubspec",
    package_config = "@pub//:project_package_config.json",
    pub_srcs = ["@pub//:all"],
)

flutter_package(
    name = "package_tester_assets",
    pub = "@pub",
    pubspec = ":pubspec",
    assets = ":assets_tester",
)

flutter_package(
    name = "package_sdk_free_assets",
    pub = "@pub",
    pubspec = ":pubspec",
    assets = ":assets_sdk_free",
)

flutter_package(
    name = "package_without_assets",
    pub = "@pub",
    pubspec = ":pubspec",
)

flutter_test(
    name = "host_test_without_assets",
    src = "test/host_test.dart",
    app = ":package_without_assets",
    include_assets = False,
)

flutter_test(
    name = "host_test_android_sdk_free",
    src = "test/host_test.dart",
    app = ":package_sdk_free_assets",
)

flutter_test(
    name = "host_test_tester_assets",
    src = "test/host_test.dart",
    app = ":package_tester_assets",
)


flutter_test_suite(
    name = "tests",
    app = "//:app",
    include_assets = False,
)
