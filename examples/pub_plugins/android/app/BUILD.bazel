# The Android half, beside the Gradle module it mirrors so both read the same
# manifest, resources and sources.

load("@rules_flutter_android//flutter:defs.bzl", "flutter_android_app")
load("@rules_kotlin//kotlin:android.bzl", "kt_android_library")

load("@rules_flutter_core//flutter:defs.bzl", "flutter_debug_core")
load("@rules_flutter_android//flutter:defs.bzl", "flutter_assets_dir")
load("@rules_android//rules:rules.bzl", "android_binary")
package(default_visibility = ["//visibility:public"])

flutter_android_app(
    name = "pub_plugins",
    core = "//:app",
    manifest_values = {"applicationId": "com.example.pub_plugins"},
    plugins = "@flutter_plugins",
    deps = [":main_activity"],
)

kt_android_library(
    name = "main_activity",
    srcs = ["src/main/kotlin/com/example/pub_plugins/MainActivity.kt"],
    deps = [":pub_plugins_inputs"],
)


flutter_debug_core(
    name = "identity_core",
    app = "//:app",
    entrypoint = "//:integration_test/debug_core_test.dart",
    dart_defines = {"DEBUG_CORE_MARK": "pub-identity"},
)

android_binary(
    name = "identity_test",
    assets = [":identity_core_bundle"],
    assets_dir = flutter_assets_dir(assets = ":identity_core_bundle_action"),
    manifest = ":pub_plugins_manifest",
    manifest_values = {
        "applicationId": "com.example.pub_plugins",
        "applicationName": "io.flutter.app.FlutterApplication",
        "minSdkVersion": "21",
        "targetSdkVersion": "36",
    },
    resource_files = glob(["src/main/res/**"], allow_empty = False),
    deps = [":main_activity", ":pub_plugins_inputs", ":pub_plugins_debug_manifest"],
)
