# The Android plugin repository renders each Java registrant from its hub's
# platform metadata. Compare each mode with flutter_tools' generated output.
# CI runs `capture.py --check`, so a Flutter template change fails there rather
# than silently here.

load("@bazel_skylib//rules:diff_test.bzl", "diff_test")

CASES = [
    "federated_default",
    "federated_dev_override",
    "federated_direct",
    "mixed",
    "no_plugins",
]

# The pub hubs read each case's lock and path packages; the Android projects
# consume their metadata and render their own registrants.
exports_files(glob(["*/app/pubspec.*"]))

[
    diff_test(
        name = "{}_{}_test".format(case, mode),
        file1 = "{}/expected/{}/GeneratedPluginRegistrant.java".format(case, mode),
        file2 = "@registrant_parity_{}_android//:generated_plugin_registrant_src".format(case),
        target_compatible_with = select({
            "@rules_flutter_core//flutter:mode_debug": [] if mode == "debug" else ["@platforms//:incompatible"],
            "@rules_flutter_core//flutter:mode_release": [] if mode == "release" else ["@platforms//:incompatible"],
        }),
    )
    for case in CASES
    for mode in ("debug", "release")
]

# What a plugin-free flutter_android_app compiles.
diff_test(
    name = "empty_registrant_test",
    file1 = "no_plugins/expected/release/GeneratedPluginRegistrant.java",
    file2 = "//flutter/private:registrant/GeneratedPluginRegistrant.java",
)
