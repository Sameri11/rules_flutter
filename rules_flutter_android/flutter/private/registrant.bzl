"""GeneratedPluginRegistrant.java matching flutter_tools for Android."""

visibility(["//flutter"])

_HEADER = """package io.flutter.plugins;

import androidx.annotation.Keep;
import androidx.annotation.NonNull;
import io.flutter.Log;

import io.flutter.embedding.engine.FlutterEngine;

/**
 * Generated file. Do not edit.
 * This file is generated by the Flutter tool based on the
 * plugins that support the Android platform.
 */
@Keep
public final class GeneratedPluginRegistrant {
  private static final String TAG = "GeneratedPluginRegistrant";
  public static void registerWith(@NonNull FlutterEngine flutterEngine) {
"""

_ENTRY = """    try {{
      flutterEngine.getPlugins().add(new {cls}());
    }} catch (Exception e) {{
      Log.e(TAG, "Error registering plugin {name}, {cls}", e);
    }}
"""

_FOOTER = """  }
}
"""
_V2_MARKER = "io.flutter.embedding.engine.plugins.FlutterPlugin"

def android_plugin(name, implements, android, direct, dev):
    if android == None:
        return None
    default_package = android.get("default_package")
    return {
        "name": name,
        "implements": implements,
        "default_package": default_package,
        "inline": default_package == None,
        "package": android.get("package"),
        "plugin_class": android.get("pluginClass"),
        "direct": direct,
        "dev": dev,
    }

def resolve_android_plugins(plugins, release):
    if release:
        plugins = [p for p in plugins if not p["dev"]]
    by_name = {p["name"]: p for p in plugins}
    candidates = {}
    defaults = {}
    for p in plugins:
        name = p["name"]
        default_name = p["default_package"]
        if default_name != None:
            if p["implements"] and not (p["implements"] == name and default_name == name):
                fail("Plugin {}:android provides an implementation for {} and also references a default implementation for {}, which flutter_tools rejects.".format(name, p["implements"], default_name))
        elif p["inline"]:
            default_name = name
        if default_name != None and default_name in by_name and by_name[default_name]["inline"]:
            defaults[name] = by_name[default_name]
        if p["inline"]:
            implemented = p["implements"] or name
            candidates.setdefault(implemented, []).append(p)
    chosen = []
    for implemented, found in candidates.items():
        if len(found) == 1:
            chosen.append(found[0])
            continue
        direct = [p for p in found if p["direct"]]
        if len(direct) == 1:
            chosen.append(direct[0])
            continue
        if direct:
            implementing = [p for p in direct if p["implements"]]
            if len(implementing) == 1 and len(direct) == 2:
                chosen.append(implementing[0])
                continue
            fail("Plugin {}:android has conflicting direct dependency implementations: {}. Remove all but one of them from pubspec.yaml.".format(implemented, ", ".join([p["name"] for p in direct])))
        default = defaults.get(implemented)
        if default != None and default in found:
            chosen.append(default)
            continue
        fail("Plugin {}:android has multiple possible implementations: {}. Add one of them to pubspec.yaml.".format(implemented, ", ".join([p["name"] for p in found])))
    return sorted(chosen, key = lambda p: p["name"])

def supports_embedding_v2(main_class_text):
    return _V2_MARKER in main_class_text

def main_class_candidates(package, plugin_class):
    base = "android/src/main/{}/" + package.replace(".", "/") + "/" + plugin_class
    return [base.format("java") + ".java", base.format("kotlin") + ".kt"]

def render_android_registrant(entries):
    return _HEADER + "".join([_ENTRY.format(name = n, cls = c) for n, c in entries]) + _FOOTER
