# Bazel output-base symlinks.
/bazel-*

# Nested-module output-base symlinks.
/tests/consumer/bazel-*
/examples/*/bazel-*

# Keep fixture `.dart_tool` files; ignore generated extension metadata.
/tests/consumer/**/.dart_tool/extension_discovery/

# Internal project notes.
/docs_internal/

# Smooth app fixture clone. See docs/package-recipes.md.
/third_party/

.DS_Store

# Gradle caches in nested projects.
.gradle/

# Android Gradle build output. Any depth: examples keep their own project-root
# `/build/` rules, and `tests/consumer/fixtures/*/android/` is a bare Gradle
# module that VS Code's Java extension syncs.
**/android/build/

# Machine-local Flutter tool state.
/examples/*/.config/
/examples/*/packages/*/.config/

# Each generated Flutter project ignores its own build output and `.dart_tool`.
# Run `flutter pub get` before Bazel; it creates the generated Bazel inputs.

# Local output of tools/ci/example_hashes.py.
/_ci_hashes/
