# Bazel's convenience symlinks into the output base. They point at
# ~/Library/Caches/bazel/... and are recreated by every build.
/bazel-*

# The consumer module is its own workspace, so it grows its own set.
/tests/consumer/bazel-*

# Keep checked-in `.dart_tool` fixtures; ignore generated editor metadata.
/tests/consumer/**/.dart_tool/extension_discovery/

# Working notes: design reasoning, measurements and dead ends. Kept out of the
# published repo for now -- see README "Further reading". Rename back to docs/
# to publish.
/docs_internal/

# Real-world test subject: a shallow clone of openfoodfacts/smooth-app, used to
# exercise these rules against a plugin graph nobody chose to suit them (30
# Android plugins). It is a nested git repository, so it cannot be tracked here
# without submodule machinery, and vendoring someone else's app into this one is
# not the intent. Re-clone it to reproduce; see docs/package-recipes.md.
/third_party/

.DS_Store

# Gradle output. app/android/.gitignore is template-managed by `flutter create`
# and does not cover this, so it is excluded here rather than by editing a file
# `flutter migrate` may rewrite.
/app/android/build/

# Flutter tool state (version checks, analytics) -- machine-local.
/app/.config/

# Note: app/build/ (1.8 GB of Flutter output) and app/.dart_tool/ (41 MB) are
# excluded by app/.gitignore, which `flutter create` generated.
#
# That file also excludes two things this Bazel build reads directly:
#
#   app/.flutter-plugins-dependencies                     (a declared Bazel input)
#   app/android/.../GeneratedPluginRegistrant.java        (an android_library src)
#
# Both are regenerated by `flutter pub get`, which a fresh clone has to run
# anyway to produce .dart_tool/package_config.json. So they stay ignored rather
# than committed as generated files -- but it does mean `bazel build` before
# `flutter pub get` fails on a missing file. See README "Fresh clone".
