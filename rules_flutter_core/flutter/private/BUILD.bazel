"""Implementation of the Flutter rules.

Nothing here is supported API: consumers load //flutter:defs.bzl and
//flutter:extensions.bzl; hand-wired targets load //flutter:composition.bzl. The `.bzl` files beside this file declare
`visibility(["//flutter"])`, except `toolchain_repo.bzl`, whose `//` visibility
allows it to be loaded from the ruleset's root MODULE.bazel only, and
`hook_packages.bzl`, whose public visibility allows generated pub hub
repositories to load its private metadata rule.

Two mechanical exceptions need a label, and only those:

  * The Python helpers are attribute defaults of rules defined here. Bazel
    resolves an implicit dependency against the package of the `.bzl` that
    defines the rule, so `//flutter:__subpackages__` is enough even though the
    rules are instantiated in another module's packages.
  * The `.bzl` files //tools/ci:key_portability_check reads as `srcs`.
    That guard parses their source for action-key portability contracts, which
    requires a label, not a load.

`repo.bzl` is loaded through the public module extension. The generated
host-compatible registration points at the public static toolchain target.
"""

load(":hook_packages_test.bzl", "staged_hook_packages_test")
load(":pub_lock_parser_test.bzl", "pub_lock_parser_test_suite")
load(":toolchain.bzl", "flutter_toolchain")

load(":rules.bzl", "flutter_target_slice")
package(default_visibility = ["//visibility:private"])

exports_files(
    [
        "check_bundle_pubspec.py",
        "check_path_deps.py",
        "lib_entry.py",
        "merge_native_assets.py",
        "read_pubspec.py",
        "tester_assets.dart",
    ],
    visibility = ["//flutter:__subpackages__"],
)

# The test-asset builder, compiled once per SDK from the flutter_tools closure in
# its own repository. Test bundles run this dill, so no action compiles
# flutter_tools or reads the pub cache. frontend_server names every source
# through the execroot scheme, so the dill carries no machine-specific paths.
genrule(
    name = "tester_assets_dill",
    srcs = [
        "tester_assets.dart",
        "@flutter_tools_packages//:flutter_tools_package_config.json",
        "@flutter_tools_packages",
        "@flutter_sdk//:vm_platform_strong.dill",
    ],
    outs = ["tester_assets.dill"],
    cmd = "d=$$PWD/$$(dirname $(execpath @flutter_sdk//:vm_platform_strong.dill)) && $(execpath @flutter_sdk//:dartaotruntime) $(execpath @flutter_sdk//:frontend_server.snapshot) --target=vm --sdk-root=$$d/ --platform=$$d/vm_platform_strong.dill --filesystem-root . --filesystem-scheme org-dartlang-root --packages=org-dartlang-root:///$(execpath @flutter_tools_packages//:flutter_tools_package_config.json) --no-print-incremental-dependencies --output-dill=$@ org-dartlang-root:///$(execpath tester_assets.dart)",
    tools = [
        "@flutter_sdk//:dartaotruntime",
        "@flutter_sdk//:frontend_server.snapshot",
    ],
    visibility = ["//flutter:__subpackages__"],
)

exports_files(
    [
        "core.bzl",
        "debug_core.bzl",
        "dart_registrant.bzl",
        "device_test.bzl",
        "flutter_test.bzl",
        "pub_lock.bzl",
        "repo.bzl",
        "rules.bzl",
        "test_kernel_driver.bzl",
    ],
    visibility = ["//tools/ci:__pkg__"],
)

flutter_toolchain(
    name = "flutter_toolchain",
    visibility = ["//visibility:public"],
)

toolchain_type(
    name = "flutter_toolchain_type",
    visibility = ["//visibility:public"],
)

toolchain_type(
    name = "flutter_target_toolchain_type",
    visibility = ["//visibility:public"],
)

toolchain_type(
    name = "flutter_aot_toolchain_type",
    no_match_error = "No Flutter AOT toolchain is registered for this platform. For Android, run `flutter precache --android` on this host to fetch the missing gen_snapshot payload.",
    visibility = ["//visibility:public"],
)

flutter_target_slice(
    name = "target_slice",
    visibility = ["//visibility:public"],
)


# What the pub lock reader accepts and, as importantly, refuses.
pub_lock_parser_test_suite(name = "pub_lock_parser_test")

staged_hook_packages_test(name = "staged_hook_packages_test")

# Public because the core's select() is expanded in the consumer's package.
config_setting(
    name = "target_os_android",
    constraint_values = ["@platforms//os:android"],
    visibility = ["//visibility:public"],
)

config_setting(
    name = "target_os_android_release",
    constraint_values = ["@platforms//os:android"],
    flag_values = {"//flutter:mode": "release"},
    visibility = ["//visibility:public"],
)
