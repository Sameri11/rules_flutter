"""The Dart plugin registrant, as the pub hub writes it to dart_plugin_registrant.dart.

Pure Starlark: the hub's repository rule renders it from the plugins it already
holds. //tools/ci:key_portability_check reads this file, so the rendered text
stays free of host paths.
"""

visibility(["//flutter"])

_DART_REGISTRANT_TEMPLATE = """//
// Generated by //flutter:extensions.bzl -- do not edit.
//
// The Dart half of plugin registration. Nothing imports this file: frontend_server
// compiles it through --source and the engine locates it via a package: URI.

import 'dart:io'; // flutter_ignore: dart_io_import.

{imports}
@pragma('vm:entry-point')
class _PluginRegistrant {{
  @pragma('vm:entry-point')
  static void register() {{
{registrations}
  }}
}}
"""

_DART_REGISTRATION = """    if (Platform.is{platform}) {{
      try {{
        {name}.{dart_class}.registerWith();
      }} catch (err) {{
        print(
          '`{name}` threw an error: $err. '
          'The app may not function as expected until you remove this plugin from pubspec.yaml'
        );
      }}
    }}
"""

_PLATFORMS = ["Android", "IOS", "Linux", "MacOS", "Windows"]

def render_dart_registrant(dart_registrations):
    """Returns a Dart registrant from (package, per-platform class/file map) entries."""
    imports = {}
    registrations = []
    for name, platforms in dart_registrations:
        for platform in _PLATFORMS:
            key = platform.lower()
            if key not in platforms:
                continue
            dart_class, dart_file = platforms[key]
            alias = "{}_{}".format(name, key)
            imports[alias] = (name, dart_file)
            registrations.append(_DART_REGISTRATION.format(
                platform = platform,
                name = alias,
                dart_class = dart_class,
            ))
    return _DART_REGISTRANT_TEMPLATE.format(
        imports = "".join([
            "import 'package:{}/{}' as {};\n".format(package, dart_file, alias)
            for alias, (package, dart_file) in sorted(imports.items())
        ]),
        registrations = "".join(registrations),
    )
