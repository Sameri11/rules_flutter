"""Provider and implementation target for the host Flutter SDK toolchain."""

visibility(["//flutter"])

FlutterToolchainInfo = provider(
    doc = "Flutter SDK files used by compiler, AOT, and asset rules.",
    fields = {
        "flutter": "Flutter command launcher file.",
        "tools_snapshot": "flutter_tools snapshot file.",
        "tools_package_config": "flutter_tools Dart package configuration.",
        "tools_packages": "Dart source and resources for flutter_tools packages.",
        "tools_cache_state": "Generated Flutter SDK cache-state files required by flutter_tools.",
        "framework_root": "Framework source repository directory.",
        "dart_sdk_root": "Dart SDK artifact repository directory.",
        "common_sdk_root": "Debug patched SDK repository directory.",
        "product_sdk_root": "Product patched SDK repository directory.",
        "sky_engine_root": "sky_engine artifact repository directory.",
        "flutter_gpu_root": "flutter_gpu artifact repository directory.",
        "host_engine_root": "Host engine artifact repository directory.",
        "font_subset_root": "font-subset artifact repository directory.",
        "material_fonts_root": "Material fonts artifact repository directory.",
        "gradle_wrapper_root": "Gradle wrapper artifact repository directory.",
        "ios_usb_roots": "macOS iOS USB artifact repository directories.",
        "piece_roots": "Declared BUILD files for source and artifact piece repositories.",
        "dartaotruntime": "Dart AOT runtime executable file.",
        "frontend_server": "Frontend server snapshot file.",
        "vm_isolate_snapshot": "Host engine's debug VM isolate snapshot file, shipped as the debug overlay's vm_snapshot_data.",
        "isolate_snapshot": "Host engine's debug isolate snapshot file, shipped as the debug overlay's isolate_snapshot_data.",
        "flutter_tester": "Flutter tester host executable, the test runtime that runs compiled kernel.",
        "icu_data": "ICU data file that flutter_tester loads.",
        "sdk_version": "Flutter SDK identity JSON file.",
        "platform_product": "Product patched SDK files.",
        "platform_debug": "Debug patched SDK files.",
        "sdk_packages": "Depset of the SDK's Dart package files: every `packages/<name>` package plus sky_engine, as lib/, pubspec.yaml and license files.",
        "dart": "Dart SDK executable file, used to run the test-kernel driver.",
        "vm_platform_strong": "VM platform dill the test-kernel driver is compiled against.",
        "dart_sdk_revision": "Dart SDK revision file; the driver's sdk_hash comes from it.",
    },
)

def _flutter_toolchain_impl(ctx):
    ios_usb_roots = {}
    ios_usb_root_files = []
    for name, files in [
        ("libimobiledevice", ctx.files._ios_usb_libimobiledevice_root),
        ("libusbmuxd", ctx.files._ios_usb_libusbmuxd_root),
        ("libplist", ctx.files._ios_usb_libplist_root),
        ("openssl", ctx.files._ios_usb_openssl_root),
        ("libimobiledeviceglue", ctx.files._ios_usb_libimobiledeviceglue_root),
        ("ios-deploy", ctx.files._ios_usb_ios_deploy_root),
    ]:
        if files:
            ios_usb_roots[name] = files[0].dirname
            ios_usb_root_files += files
    return [platform_common.ToolchainInfo(flutter = FlutterToolchainInfo(
        flutter = ctx.file._flutter,
        tools_snapshot = ctx.file._tools_snapshot,
        tools_package_config = ctx.file._tools_package_config,
        tools_packages = depset(ctx.files._tools_packages),
        tools_cache_state = depset(ctx.files._tools_cache_state),
        framework_root = ctx.file._framework_source_root.dirname,
        dart_sdk_root = ctx.file._dart_sdk_root.dirname,
        common_sdk_root = ctx.file._patched_sdk_root.dirname,
        product_sdk_root = ctx.file._patched_sdk_product_root.dirname,
        sky_engine_root = ctx.file._sky_engine_root.dirname,
        flutter_gpu_root = ctx.file._flutter_gpu_root.dirname,
        host_engine_root = ctx.file._host_artifacts_root.dirname,
        font_subset_root = ctx.file._font_subset_root.dirname,
        material_fonts_root = ctx.file._material_fonts_root.dirname,
        gradle_wrapper_root = ctx.file._gradle_wrapper_root.dirname,
        piece_roots = [
            ctx.file._framework_source_root,
            ctx.file._dart_sdk_root,
            ctx.file._patched_sdk_root,
            ctx.file._patched_sdk_product_root,
            ctx.file._sky_engine_root,
            ctx.file._flutter_gpu_root,
            ctx.file._host_artifacts_root,
            ctx.file._font_subset_root,
            ctx.file._material_fonts_root,
            ctx.file._gradle_wrapper_root,
        ] + ios_usb_root_files,
        ios_usb_roots = ios_usb_roots,
        dartaotruntime = ctx.executable._dartaotruntime,
        dart = ctx.executable._dart,
        vm_platform_strong = ctx.file._vm_platform_strong,
        dart_sdk_revision = ctx.file._dart_sdk_revision,
        frontend_server = ctx.file._frontend_server,
        vm_isolate_snapshot = ctx.file._vm_isolate_snapshot,
        isolate_snapshot = ctx.file._isolate_snapshot,
        flutter_tester = ctx.executable._flutter_tester,
        icu_data = ctx.file._icu_data,
        sdk_version = ctx.file._sdk_version,
        platform_product = ctx.files._platform_product,
        platform_debug = ctx.files._platform_debug,
        sdk_packages = depset(ctx.files._sdk_packages),
    ))]

def _toolchain_attrs():
    return {
        "_flutter": attr.label(default = "@flutter_sdk//:flutter", allow_single_file = True),
        "_tools_snapshot": attr.label(default = "//flutter/private:flutter_tools_snapshot", allow_single_file = True),
        "_tools_package_config": attr.label(default = "@flutter_tools//:package_config.json", allow_single_file = True),
        "_tools_packages": attr.label(default = "@flutter_tools//:lib", allow_files = True),
        "_tools_cache_state": attr.label(default = "@flutter_sdk//:flutter_tools_cache_state", allow_files = True),
        "_dart": attr.label(default = "@flutter_sdk//:dart", executable = True, cfg = "exec", allow_single_file = True),
        "_dartaotruntime": attr.label(default = "@flutter_sdk//:dartaotruntime", executable = True, cfg = "exec", allow_single_file = True),
        "_vm_platform_strong": attr.label(default = "@flutter_sdk//:vm_platform_strong.dill", allow_single_file = True),
        "_dart_sdk_revision": attr.label(default = "@flutter_sdk//:dart_sdk_revision", allow_single_file = True),
        "_frontend_server": attr.label(default = "@flutter_sdk//:frontend_server.snapshot", allow_single_file = True),
        "_vm_isolate_snapshot": attr.label(default = "@flutter_sdk//:vm_isolate_snapshot.bin", allow_single_file = True),
        "_isolate_snapshot": attr.label(default = "@flutter_sdk//:isolate_snapshot.bin", allow_single_file = True),
        "_flutter_tester": attr.label(default = "@flutter_sdk//:flutter_tester", executable = True, cfg = "exec", allow_single_file = True),
        "_icu_data": attr.label(default = "@flutter_sdk//:icudtl.dat", allow_single_file = True),
        "_sdk_version": attr.label(default = "@flutter_sdk//:flutter.version.json", allow_single_file = True),
        "_framework_source_root": attr.label(default = "@flutter_sdk//:framework_source_root", allow_single_file = True),
        "_dart_sdk_root": attr.label(default = "@flutter_sdk//:dart_sdk_root", allow_single_file = True),
        "_patched_sdk_root": attr.label(default = "@flutter_sdk//:patched_sdk_root", allow_single_file = True),
        "_patched_sdk_product_root": attr.label(default = "@flutter_sdk//:patched_sdk_product_root", allow_single_file = True),
        "_sky_engine_root": attr.label(default = "@flutter_sdk//:sky_engine_root", allow_single_file = True),
        "_flutter_gpu_root": attr.label(default = "@flutter_sdk//:flutter_gpu_root", allow_single_file = True),
        "_host_artifacts_root": attr.label(default = "@flutter_sdk//:host_artifacts_root", allow_single_file = True),
        "_font_subset_root": attr.label(default = "@flutter_sdk//:font_subset_root", allow_single_file = True),
        "_material_fonts_root": attr.label(default = "@flutter_sdk//:material_fonts_root", allow_single_file = True),
        "_gradle_wrapper_root": attr.label(default = "@flutter_sdk//:gradle_wrapper_root", allow_single_file = True),
        "_ios_usb_libimobiledevice_root": attr.label(default = "@flutter_sdk//:ios_usb_libimobiledevice_root", allow_files = True),
        "_ios_usb_libusbmuxd_root": attr.label(default = "@flutter_sdk//:ios_usb_libusbmuxd_root", allow_files = True),
        "_ios_usb_libplist_root": attr.label(default = "@flutter_sdk//:ios_usb_libplist_root", allow_files = True),
        "_ios_usb_openssl_root": attr.label(default = "@flutter_sdk//:ios_usb_openssl_root", allow_files = True),
        "_ios_usb_libimobiledeviceglue_root": attr.label(default = "@flutter_sdk//:ios_usb_libimobiledeviceglue_root", allow_files = True),
        "_ios_usb_ios_deploy_root": attr.label(default = "@flutter_sdk//:ios_usb_ios_deploy_root", allow_files = True),
        "_platform_product": attr.label(default = "@flutter_sdk//:platform_product", allow_files = True),
        "_platform_debug": attr.label(default = "@flutter_sdk//:platform_debug", allow_files = True),
        "_sdk_packages": attr.label(default = "@flutter_sdk//:sdk_packages", allow_files = True),
    }

flutter_toolchain = rule(
    implementation = _flutter_toolchain_impl,
    attrs = _toolchain_attrs(),
)
