load("@bazel_skylib//rules:common_settings.bzl", "int_flag", "string_flag")
load(":modes.bzl", "MODES")

package(default_visibility = ["//visibility:public"])

exports_files([
    "defs.bzl",
    "composition.bzl",
    "extensions.bzl",
    "target_toolchain.bzl",
])

# The Flutter SDK toolchain type, for rules outside this module. The type is
# declared in flutter/private; this alias is the name other modules use.
alias(
    name = "toolchain_type",
    actual = "//flutter/private:flutter_toolchain_type",
    visibility = ["//visibility:public"],
)

# Platform rulesets register these public toolchain types by label.
alias(
    name = "target_toolchain_type",
    actual = "//flutter/private:flutter_target_toolchain_type",
    visibility = ["//visibility:public"],
)

alias(
    name = "aot_toolchain_type",
    actual = "//flutter/private:flutter_aot_toolchain_type",
    visibility = ["//visibility:public"],
)

# Flutter runtime mode, independent of --compilation_mode.
string_flag(
    name = "mode",
    build_setting_default = "release",
    values = MODES,
)

# Test kernels compile in the worker by default; frontend_server selects the one-shot action.
string_flag(
    name = "test_kernel_compiler",
    build_setting_default = "worker",
    values = [
        "worker",
        "frontend_server",
    ],
)

# Memory reserved per test-kernel worker action, in MB; rounded up to the next fixed step.
int_flag(
    name = "test_kernel_memory_mb",
    build_setting_default = 2048,
)

config_setting(
    name = "mode_debug",
    flag_values = {":mode": "debug"},
)

config_setting(
    name = "mode_release",
    flag_values = {":mode": "release"},
)

# Host-side decoder for Flutter's device-test frame protocol.
filegroup(
    name = "device_test_decoder",
    srcs = [
        "//flutter/private/test/driver:device_decoder.dart",
        "//flutter/private/test/driver:frame.dart",
        "//flutter/private/test/driver:junit.dart",
        "//flutter/private/test/driver:results.dart",
    ],
)
