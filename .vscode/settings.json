{
  // Not "@buildifier_prebuilt//:buildifier": an @-prefixed value makes the
  // extension run `bazel run`, whose toolchain resolution fetches @androidndk
  // and so needs ANDROID_NDK_HOME, which a GUI launch of VS Code does not have.
  "bazel.buildifierExecutable": "buildifier",
  "bazel.buildifierFixOnFormat": true,

  "[starlark]": {
    "editor.defaultFormatter": "bazelbuild.vscode-bazel",
    "editor.formatOnSave": true
  },

  // bazel-* are symlinks into the output base; the rest are build output.
  "files.exclude": {
    "bazel-*": true
  },
  "files.watcherExclude": {
    "**/.dart_tool/**": true,
    "**/build/**": true,
    "bazel-*": true,
    "third_party/**": true
  },
  "search.exclude": {
    "bazel-*": true
  }
}
