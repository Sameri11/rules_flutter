module(
    name = "flutter_bazel",
    version = "0.1.0",
)

flutter = use_extension("//tools/flutter:repo.bzl", "flutter")
use_repo(
    flutter,
    "flutter_embedding",
    "flutter_engine_arm64_v8a",
    "flutter_engine_armeabi_v7a",
    "flutter_engine_x86_64",
    "flutter_sdk",
)

# One target per native Android plugin, read from the same
# .flutter-plugins-dependencies that Gradle's FlutterAppPluginLoaderPlugin uses.
# `pub get` rewrites that file, so adding a plugin to pubspec.yaml is what
# changes this graph -- nothing here is edited per plugin.
plugins = use_extension("//tools/flutter:plugins.bzl", "flutter_plugins_ext")
plugins.project(
    # Every ABI the plugins' native halves are cross-compiled for. Must cover
    # what //app/android/app declares, or the APK ships an ABI with no plugin
    # libraries in it. Unbuilt ABIs cost nothing: bzlmod fetches and CMake runs
    # only for what something demands.
    abis = [
        "arm64-v8a",
        "x86_64",
        "armeabi-v7a",
    ],
    # The embedding target lives in the app, not in the rules -- see
    # //app/android/app:BUILD.bazel.
    embedding = "//app/android/app:flutter_embedding",
    metadata = "//app:.flutter-plugins-dependencies",
    # Needed only because a recipe below names `sqlite3`, which is not a Flutter
    # plugin and so appears nowhere in the metadata file. Written by the same
    # `pub get`, and the only thing that resolves such a package to a directory.
    package_config = "//app:.dart_tool/package_config.json",
)

# Per-package escape hatches. `plugins.package()` is the only one there is: it
# carries both the module-time facts (Maven coordinates) and the analysis-time
# ones (which recipe builds this package), because those cross a phase boundary
# and cannot be expressed by the same mechanism -- see the tag_class comment in
# //tools/flutter:plugins.bzl.
#

use_repo(plugins, "flutter_plugins")

bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.3", dev_dependency = True)

# For build_test, which is what makes the guard rules runnable under
# `bazel test`. The guards fail as *actions*, which is stronger than a test --
# anything depending on them fails too -- so they are wrapped rather than
# converted. Already in the graph via buildifier_prebuilt, so declaring it
# direct fetches nothing new.
bazel_dep(name = "bazel_skylib", version = "1.8.2", dev_dependency = True)

# --- Android ---------------------------------------------------------------
# http_jar generates a java_import, so rules_java must be visible to this
# module for the engine artifact repos to load.
bazel_dep(name = "rules_java", version = "9.3.0")
bazel_dep(name = "rules_android", version = "0.7.3")

# Kotlin is the default language of the flutter Android template; MainActivity
# is generated as .kt. Compiling it directly avoids maintaining a Java twin.
bazel_dep(name = "rules_kotlin", version = "2.4.0")

# --- Native plugin builds (CMake) -------------------------------------------
# `externalNativeBuild` plugins ship C/C++ that AGP compiles by running CMake.
# We run the plugin's own CMakeLists too, rather than translating it: a
# CMakeLists we cannot accommodate then fails at build time instead of yielding
# a .so that loads and misbehaves. See docs/plugins.md.
#
# The NDK's own build/cmake/android.toolchain.cmake is what plugin CMakeLists
# are written and tested against, and it is handed to cmake() through a
# CMAKE_TOOLCHAIN_FILE cache entry -- a documented rules_foreign_cc attribute
# that suppresses its synthesized crosstool. Letting it synthesize one instead
# does not link the NDK C++ STL and dies at link time.
bazel_dep(name = "rules_foreign_cc", version = "0.15.1")

# Explicit rather than inherited: the native cc rules were removed from Bazel,
# so `rules_cc` has to be visible to this module for //tools/flutter:android.bzl
# to load find_cc_toolchain.bzl -- which is how the strip rules reach the NDK's
# llvm-strip instead of hardcoding a path. Only the Android half needs it.
bazel_dep(name = "rules_cc", version = "0.2.17")

# Supplies the cc_toolchain that cmake() resolves for the Android platform, and
# locates the NDK. Both this and the CMAKE_TOOLCHAIN_FILE above read
# ANDROID_NDK_HOME, so there is one source of truth for the path.
#
# NDK 28 is the enforced minimum -- see the version guard in plugins.bzl.
bazel_dep(name = "rules_android_ndk", version = "0.1.5")

# Wrapped rather than used directly, so an absent NDK yields a toolchain-less
# stub instead of a failed fetch. See //tools/flutter:ndk.bzl.
# A repo created by an extension resolves apparent names against the module
# owning that extension, so wrapping the NDK moved its BUILD's references here.
# `platforms` is declared for that alone.
bazel_dep(name = "platforms", version = "1.0.0")

android_ndk = use_extension("//tools/flutter:ndk.bzl", "android_ndk")
use_repo(android_ndk, "androidndk")

register_toolchains("@androidndk//:all")

remote_android_extensions = use_extension(
    "@bazel_tools//tools/android:android_extensions.bzl",
    "remote_android_tools_extensions",
)
use_repo(remote_android_extensions, "android_gmaven_r8", "android_tools")

android_sdk_repository_extension = use_extension(
    "@rules_android//rules/android_sdk_repository:rule.bzl",
    "android_sdk_repository_extension",
)
use_repo(android_sdk_repository_extension, "androidsdk")

register_toolchains("@androidsdk//:all")

# The Maven artifacts -- the embedding's AndroidX dependencies and every
# plugin's -- are declared in the generated segment included at the bottom of
# this file, not here. They must be one maven.install: two install tags sharing
# a repository name merge into a single resolution in which the later tag wins
# outright, which let a plugin downgrade an artifact the embedding declared.
# The coordinates themselves live in //tools/flutter:embedding.bzl.
#
# 6.10+ loads aar_import from @rules_android//android:rules.bzl. 6.9 used the
# legacy @build_bazel_rules_android name, which is not visible under bzlmod and
# breaks AAR resolution on Bazel 9.
bazel_dep(name = "rules_jvm_external", version = "7.1")

# Maven coordinates the Flutter plugins declare. Generated -- see
# //tools/flutter:plugins.bzl and //app:plugins_check.
include("//:plugin_deps.MODULE.bazel")

# --- Packages that fall outside the standard build ---------------------------
#
# Both are declared with plugins.package() above and built by recipes in
# //bazel/flutter. What is left here is the part a recipe cannot do: fetching.
# A repository rule cannot be called from a macro, and pinning a download is a
# module-time act, so the archives are named here and the recipes consume them.
#
# Keeping the fetch here rather than inside an action is the point. Upstream both
# packages download at build time -- rive_native from a Gradle Exec task, sqlite3
# from inside its Dart build hook -- with no record of what arrived. Declared this
# way the hashes land in MODULE.bazel.lock and no action touches the network.
#
# sqlite3 is not a Flutter plugin: no android/ module, nothing in
# .flutter-plugins-dependencies. Its native half comes from hook/build.dart,
# whose default path (no user defines) is PrecompiledFromGithubAssets -- a
# download from a GitHub release with the sha256 published in the package's own
# lib/src/hook/asset_hashes.dart. So it is an http_file, exactly.
#
# Both the tag and the hash are transcribed from asset_hashes.dart for the
# resolved version (3.5.0), and verified against the downloaded bytes.
http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

# One per ABI. The package names its architectures the way Dart does -- arm64,
# arm, x64 -- so the mapping to an Android ABI happens here and nowhere else.
# `ia32` is published too and is deliberately absent: there is no android-x86
# engine to pair it with.
#
# Every hash is transcribed from asset_hashes.dart for the resolved version,
# and each downloaded file is named libsqlite3.so because the bundle's
# NativeAssetsManifest.json says ["absolute", "libsqlite3.so"] -- dlopen misses
# on any other name. //bazel/flutter:sqlite3.bzl restates that as a code_assets
# entry, so the recipe fails rather than the app.
[
    http_file(
        name = "libsqlite3_android_" + abi.replace("-", "_"),
        downloaded_file_path = "libsqlite3.so",
        sha256 = sha256,
        urls = ["https://github.com/simolus3/sqlite3.dart/releases/download/" +
                "sqlite3-3.5.0/libsqlite3." + arch + ".android.so"],
    )
    for abi, arch, sha256 in [
        (
            "arm64-v8a",
            "arm64",
            "e99515af1d7119fb61843ae5e597344e7f258563de3a7e5a3869f627aab2887b",
        ),
        (
            "x86_64",
            "x64",
            "e5a2d46ac5e11f471e1aaedfd364f54c7961a6900432d289ea3f5781bcaaf4cd",
        ),
        (
            "armeabi-v7a",
            "arm",
            "6c1b8dffc1ddefaf02e771711491410bc3ab1db858d3d23d2925e0b2cd691b93",
        ),
    ]
]

# The recipes themselves. Each names a .bzl in this project and a macro in it;
# //tools/flutter:plugins.bzl generates a BUILD that loads the macro by canonical
# label and hands it the facts the generator would have used.
plugins.package(
    name = "rive_native",
    bzl_file = "//bazel/flutter:rive_native.bzl",
    macro = "rive_native_recipe",
)
plugins.package(
    name = "sqlite3",
    bzl_file = "//bazel/flutter:sqlite3.bzl",
    macro = "sqlite3_recipe",
)

# rive_native: an ordinary Kotlin Android module whose native half is never
# compiled. Upstream, a Gradle `Exec` task shells out to
# `dart run rive_native:setup -p android`, which downloads this exact archive and
# unpacks it into src/main/jniLibs/. Nothing here runs Gradle, so the .so simply
# never arrives -- hence the `prebuilt_jni_libs` gate.
#
# URL built the way bin/setup.dart:464 builds it:
#   .../rive_native_versions/<uri-encoded version.txt>/rive_native_artifacts_<platform>.zip
# version.txt is `0.1.10+2`, so the `+` is percent-encoded.
#
# The sha256 below is ours, but it is not a free-floating transcription: the
# package ships hash.txt, whose "android" sha512 pins this same zip
# byte-for-byte (verified). So an upgrade that changes the archive is detectable
# rather than silent -- a guard target for that is worth having later.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "rive_native_android",
    # The archive holds <abi>/librive_native.so for all four Android ABIs at its
    # root, so an extra ABI is a filegroup, not a second download. x86 is left
    # out for the same reason as sqlite3's ia32: no engine to pair it with.
    build_file_content = """
[
    filegroup(
        name = abi.replace("-", "_"),
        srcs = [abi + "/librive_native.so"],
        visibility = ["//visibility:public"],
    )
    for abi in ["arm64-v8a", "x86_64", "armeabi-v7a"]
]
""",
    sha256 = "765a4e5e7e244eb849c76af105d5dc9a33fa02401cd37e6f24720d8c8941498b",
    urls = ["https://rive-flutter-artifacts.rive.app/rive_native_versions/" +
            "0.1.10%2B2/rive_native_artifacts_android.zip"],
)
