# Action execution policy lives in tools/flutter/defs.bzl; do not set a global
# spawn strategy here.
common --enable_bzlmod

# Configure a remote cache here when absolute-path inputs are canonicalised.
# build --remote_cache=grpc://...

# Shared Android flags; each nested module imports this file and opts in locally.
import %workspace%/.bazelrc.android

common --config=android
